---
/**
 * src/components/InsightsCTA.astro
 * 
 * Call-to-action section for Insights page
 */
---

<section class="insights-cta">
  <div class="cta-content">
    <h2 class="cta-title">Stay Ahead of What's Next</h2>
    <p class="cta-description">
      Explore new ideas, practical AI applications and engineering perspectives that help businesses build smarter systems.
    </p>
    <a href="/contact/" class="cta-button">Discuss Your Project</a>
  </div>
</section>

<style>
  .insights-cta {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .cta-content {
    background: linear-gradient(135deg, #f8fbff 0%, #ffffff 100%);
    border: 1px solid rgba(22, 119, 255, 0.15);
    border-radius: var(--radius);
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cta-title {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .cta-description {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-button {
    display: inline-block;
    padding: 12px 32px;
    background: var(--blue);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(22, 119, 255, 0.3);
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  @media (hover: hover) {
    .cta-button:hover {
      background: var(--blue-hover);
      box-shadow: 0 6px 20px rgba(22, 119, 255, 0.4);
      transform: translateY(-2px);
    }
  }

  .cta-button:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .insights-cta {
      padding: 3rem 1.5rem;
    }

    .cta-content {
      padding: 2.5rem 1.5rem;
    }

    .cta-title {
      font-size: 1.5rem;
    }

    .cta-description {
      font-size: 1rem;
    }

    .cta-button {
      padding: 10px 24px;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .insights-cta {
      padding: 2rem 1rem;
    }

    .cta-content {
      padding: 2rem 1.25rem;
      gap: 1.25rem;
    }

    .cta-title {
      font-size: 1.25rem;
    }

    .cta-description {
      font-size: 0.9rem;
    }

    .cta-button {
      padding: 10px 20px;
      font-size: 0.85rem;
    }
  }
</style>
