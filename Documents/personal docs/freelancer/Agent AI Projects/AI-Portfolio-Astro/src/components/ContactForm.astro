  /**
   * Form Submission Handler
   * - Prevents default form submission
   * - Collects form data via FormData API
   * - Submits to Formspree endpoint
   * - Shows loading state
   * - Displays success or error feedback
   * - Opens success modal on successful submission
   */

  const form = document.getElementById('enquiry-form') as HTMLFormElement;
  const submitButton = form?.querySelector('.submit-button') as HTMLButtonElement;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');
  const successModal = document.getElementById('success-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault();

      // Reset messages
      successMessage?.classList.add('hidden');
      errorMessage?.classList.add('hidden');

      // Get form data
      const formData = new FormData(form);

      // Show loading state
      submitButton.disabled = true;
      const originalText = submitButton.textContent;
      submitButton.textContent = 'Sending...';

      try {
        // Prepare data for Formspree
        const response = await fetch(site.formspree.endpoint, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: new URLSearchParams(formData as any).toString(),
        });

        if (response.ok) {
          // Success: show success message and modal
          successMessage?.classList.remove('hidden');
          
          // Reset form
          form.reset();

          // Show success modal
          successModal?.classList.remove('hidden');

          // Reset button
          submitButton.textContent = originalText;
          submitButton.disabled = false;
        } else {
          // Error response from Formspree
          errorMessage?.classList.remove('hidden');
          submitButton.textContent = originalText;
          submitButton.disabled = false;
        }
      } catch (error) {
        // Network error or other failure
        console.error('Form submission error:', error);
        errorMessage?.classList.remove('hidden');
        submitButton.textContent = originalText;
        submitButton.disabled = false;
      }
    });
  }

  /**
   * Modal Controls
   * - Close modal on "Got it" button click
   * - Close modal on Escape key press
   * - Close modal on backdrop click
   */

  if (modalCloseBtn) {
    modalCloseBtn.addEventListener('click', () => {
      successModal?.classList.add('hidden');
    });
  }

  if (successModal) {
    // Close on Escape key
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && !successModal.classList.contains('hidden')) {
        successModal.classList.add('hidden');
      }
    });

    // Close on backdrop click
    const backdrop = successModal.querySelector('.modal-backdrop') as HTMLElement;
    if (backdrop) {
      backdrop.addEventListener('click', () => {
        successModal.classList.add('hidden');
      });
    }
  }
</script>
