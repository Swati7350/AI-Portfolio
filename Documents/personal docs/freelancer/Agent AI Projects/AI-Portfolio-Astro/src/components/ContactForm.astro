<form id="enquiry-form" class="enquiry-form">
          <!-- Name Field -->
          <div class="form-group">
            <label for="contact-name" class="form-label">
              Name <span class="required">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              class="form-input"
              autocomplete="name"
            />
          </div>

          <!-- Email Field -->
          <div class="form-group">
            <label for="contact-email" class="form-label">
              Work Email <span class="required">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              class="form-input"
              autocomplete="email"
            />
          </div>

          <!-- Company Field -->
          <div class="form-group">
            <label for="contact-company" class="form-label">
              Company <span class="optional">(optional)</span>
            </label>
            <input
              type="text"
              id="contact-company"
              name="company"
              class="form-input"
              autocomplete="organization"
            />
          </div>

          <!-- What are you trying to improve -->
          <div class="form-group">
            <label for="contact-improve" class="form-label">
              What can we help you with? <span class="required">*</span>
            </label>
            <select id="contact-improve" name="improve" required class="form-select">
              <option value="">Select the closest match</option>
              <option value="Generate and manage more leads">Generate and manage more leads</option>
              <option value="Automate customer support">Automate customer support</option>
              <option value="Automate document processing">Automate document processing</option>
              <option value="Automate sales / CRM workflows">Automate sales / CRM workflows</option>
              <option value="Automate internal operations">Automate internal operations</option>
              <option value="Build an AI agent">Build an AI agent</option>
              <option value="Build a custom AI application">Build a custom AI application</option>
              <option value="Automate social media scheduling and publishing across platforms">Automate social media scheduling and publishing across platforms</option>
            </select>
          </div>

          <!-- Current Process -->
          <div class="form-group">
            <label for="contact-process" class="form-label">
              Tell us about your project <span class="required">*</span>
            </label>
            <textarea
              id="contact-process"
              name="process"
              required
              class="form-textarea"
              placeholder="Describe what your team is doing today, where the manual work happens, and what outcome you're looking for."
            ></textarea>
          </div>

          <!-- Timeline -->
          <div class="form-group">
            <label for="contact-timeline" class="form-label">
              Timeline <span class="optional">(optional)</span>
            </label>
            <select id="contact-timeline" name="timeline" class="form-select">
              <option value="">Select a timeline</option>
              <option value="ASAP">ASAP</option>
              <option value="1–3 months">1–3 months</option>
              <option value="3+ months">3+ months</option>
              <option value="Just exploring">Just exploring</option>
            </select>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="submit-button">
            Send Enquiry →
          </button>

          <!-- Trust Message -->
          <p class="form-trust-message">Your next big improvement could start with a simple conversation.</p>

          <!-- Success Message -->
          <div id="success-message" class="form-success hidden">
            <p>Thanks for reaching out.</p>
            <p>We've received your enquiry. We review every submission during business hours and will be in touch shortly.</p>
          </div>

          <!-- Error Message -->
          <div id="error-message" class="form-error hidden">
            <p>Something went wrong. Please try again or reach out via LinkedIn or Upwork.</p>
          </div>
        </form></section>
