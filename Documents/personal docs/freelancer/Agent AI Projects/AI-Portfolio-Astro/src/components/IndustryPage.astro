---
/**
 * src/components/IndustryPage.astro
 * 
 * Individual industry page template with:
 * - Hero section with CTAs
 * - Challenges section
 * - Solutions section
 * - How We Help section
 * - Capabilities section
 * - Workflow diagram
 * - FAQ accordion
 * - CTA section
 */

import type { Industry } from '../data/industries';
import WorkflowDiagram from './WorkflowDiagram.astro';
import FAQAccordion from './FAQAccordion.astro';

interface Props {
  industry: Industry;
}

const { industry } = Astro.props;

const howWeHelpContent: Record<string, string> = {
  healthcare: "We combine AI engineering with healthcare expertise to build intelligent systems that respect patient privacy while automating administrative workflows. Our AI receptionists, document intelligence systems, and custom EHR integrations transform how practices manage appointments, engage patients, and handle compliance.",
  ecommerce: "We engineer end-to-end commerce automation that connects your channels, powers your customer experience, and streamlines operations. From AI-driven support to inventory synchronization across marketplaces, we build systems that scale with your growth.",
  manufacturing: "We modernize industrial operations by connecting disconnected systems and automating document-heavy workflows. Our solutions extract intelligence from your data, streamline procurement, and provide real-time operational visibility for better decision-making.",
  "finance-accounting": "We transform financial operations through intelligent document processing and workflow automation. Our systems eliminate manual data entry, accelerate reconciliation, and ensure audit-ready accuracy—giving your finance team hours back each week.",
  "logistics-supply-chain": "We build connected supply chain systems that track shipments, synchronize inventory, and automate vendor communication in real-time. Our solutions provide complete operational visibility and faster response to supply chain disruptions.",
  "professional-services": "We automate the business operations of service firms—from lead qualification and CRM workflows to proposal generation and client onboarding. Our AI systems handle repetitive work so your team focuses on client delivery and growth.",
};
---

<!-- Hero Section -->
<section class="industry-hero" aria-labelledby="industry-hero-title">
  <div class="industry-hero-inner">
    <div class="industry-hero-content">
      <a href="/industries/" class="breadcrumb">← Back to Industries</a>
      <h1 id="industry-hero-title">{industry.headline}</h1>
      <p class="hero-description">{industry.description}</p>
    </div>
  </div>
</section>

<!-- Challenges Section -->
<section class="industry-section challenges-section" aria-labelledby="challenges-title">
  <div class="industry-shell">
    <header class="section-header">
      <span class="section-eyebrow">CURRENT STATE</span>
      <h2 id="challenges-title">Operational Challenges in {industry.name}</h2>
      <p>Organizations across {industry.name.toLowerCase()} face these common operational bottlenecks:</p>
    </header>

    <div class="challenges-grid">
      {industry.challenges.map((challenge) => (
        <article class="challenge-card">
          <h3>{challenge.title}</h3>
          <p>{challenge.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Solutions Section -->
<section class="industry-section solutions-section" aria-labelledby="solutions-title">
  <div class="industry-shell">
    <header class="section-header">
      <span class="section-eyebrow">SOLUTIONS WE BUILD</span>
      <h2 id="solutions-title">Intelligent Solutions for {industry.name}</h2>
      <p>We engineer tailored AI and automation solutions that directly address these challenges:</p>
    </header>

    <div class="solutions-grid">
      {industry.solutions.map((solution) => (
        <article class="solution-card">
          <h3>{solution.title}</h3>
          <p class="solution-description">{solution.description}</p>
          <div class="solution-benefit">
            <span class="benefit-label">Benefit:</span>
            <p>{solution.benefit}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- How We Help Section -->
<section class="industry-section how-we-help-section" aria-labelledby="how-we-help-title">
  <div class="industry-shell">
    <header class="section-header">
      <span class="section-eyebrow">OUR APPROACH</span>
      <h2 id="how-we-help-title">How We Help {industry.name}</h2>
    </header>
    <div class="how-we-help-content">
      <p>{howWeHelpContent[industry.id] || "We combine AI engineering with industry expertise to build intelligent systems tailored to your unique workflows."}</p>
    </div>
  </div>
</section>

<!-- Capabilities Section -->
<section class="industry-section capabilities-section" aria-labelledby="capabilities-title">
  <div class="industry-shell">
    <header class="section-header">
      <span class="section-eyebrow">TECHNICAL CAPABILITIES</span>
      <h2 id="capabilities-title">Applied Capabilities</h2>
      <p>For {industry.name.toLowerCase()}, we apply these core technical capabilities:</p>
    </header>

    <div class="capabilities-grid">
      {industry.capabilities.map((capability) => (
        <div class="capability-item">
          <div class="capability-content">
            <h3>{capability.name}</h3>
            {capability.description && <p>{capability.description}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Workflow Section -->
<section class="industry-workflow-section">
  <div class="industry-shell">
    <WorkflowDiagram 
      steps={industry.workflow}
      title={`How ${industry.name} Solutions Work`}
    />
  </div>
</section>

<!-- FAQ Section -->
<section class="industry-faq-section">
  <div class="industry-shell">
    <FAQAccordion 
      faqs={industry.faqs}
      title={`${industry.name} FAQ`}
    />
  </div>
</section>

<!-- Final CTA Section -->
<section class="industry-cta-section" aria-labelledby="industry-cta-title">
  <div class="industry-shell">
    <div class="cta-content">
      <h2 id="industry-cta-title">Ready to Build Smarter Systems for Your Business?</h2>
      <p>Let's discuss how intelligent automation can streamline your workflows and drive growth.</p>
      <a href="/contact/" class="cta-button">Discuss Your Project</a>
    </div>
  </div>
</section>

<style>
  .industry-hero {
    padding: 60px 1.5rem;
    background: linear-gradient(135deg, #0B1F44 0%, #102A43 50%, #1E3A5F 100%);
    color: #FFFFFF;
  }

  .industry-hero-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.85rem;
    text-decoration: none;
    margin-bottom: 1.2rem;
  }

  .breadcrumb:hover {
    color: #22D3EE;
  }

  .industry-hero-content h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1.5rem;
  }

  .industry-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .industry-section {
    padding: 64px 1.5rem;
  }

  .challenges-section {
    background: linear-gradient(135deg, #f5f9fd 0%, #f9fafb 100%);
  }

  .solutions-section {
    background: #FFFFFF;
  }

  .how-we-help-section {
    background: #FFFFFF;
  }

  .capabilities-section {
    background: linear-gradient(135deg, #f5f9fd 0%, #f9fafb 100%);
  }

  .section-header {
    max-width: 760px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .section-eyebrow {
    color: #2563eb;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .section-header h2 {
    margin: 0.8rem 0 0.8rem;
    color: #102a43;
    font: 700 clamp(1.8rem, 5vw, 2.6rem) / 1.1 "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
    letter-spacing: -0.02em;
  }

  .section-header p {
    max-width: 590px;
    margin: 0 auto;
    color: #62788e;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .how-we-help-content {
    max-width: 760px;
    margin: 0 auto;
  }

  .how-we-help-content p {
    color: #62788e;
    font-size: 1rem;
    line-height: 1.8;
    margin: 0;
  }

  /* Challenges Grid */
  .challenges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  @media (min-width: 1024px) {
    .challenges-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .challenge-card {
    padding: 20px;
    background: #FFFFFF;
    border: 1px solid #DCE7F3;
    border-left: 4px solid #22D3EE;
    border-radius: 10px;
  }

  .challenge-card:hover {
    border-left-color: #06B6D4;
    box-shadow: 0 4px 12px rgba(34, 211, 238, 0.08);
  }

  .challenge-card h3 {
    margin: 0 0 0.5rem;
    color: #102A43;
    font-size: 1rem;
    font-weight: 700;
  }

  .challenge-card p {
    margin: 0;
    color: #62788e;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Solutions Grid */
  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  @media (min-width: 1024px) {
    .solutions-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  .solution-card {
    padding: 20px;
    background: linear-gradient(135deg, #f5f9fd 0%, #f9fafb 100%);
    border: 1px solid #E5ECF3;
    border-radius: 10px;
  }

  .solution-card:hover {
    border-color: rgba(34, 211, 238, 0.3);
    box-shadow: 0 4px 12px rgba(34, 211, 238, 0.06);
  }

  .solution-card h3 {
    margin: 0 0 0.5rem;
    color: #102A43;
    font-size: 1rem;
    font-weight: 700;
  }

  .solution-description {
    margin: 0 0 0.75rem;
    color: #62788e;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .solution-benefit {
    padding-top: 0.75rem;
    border-top: 1px solid #E5ECF3;
  }

  .benefit-label {
    font-weight: 600;
    color: #0B1F44;
    font-size: 0.8rem;
  }

  .solution-benefit p {
    margin: 0.4rem 0 0;
    color: #2563EB;
    font-size: 0.85rem;
    line-height: 1.5;
    font-weight: 500;
  }

  /* Capabilities Grid */
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  @media (min-width: 768px) {
    .capabilities-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (min-width: 1024px) {
    .capabilities-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .capability-item {
    display: flex;
    gap: 1rem;
    padding: 16px;
    background: #FFFFFF;
    border: 1px solid #E5ECF3;
    border-radius: 10px;
  }

  .capability-item:hover {
    border-color: rgba(34, 211, 238, 0.3);
    box-shadow: 0 2px 6px rgba(34, 211, 238, 0.05);
  }

  .capability-content h3 {
    margin: 0 0 0.2rem;
    color: #102A43;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .capability-content p {
    margin: 0;
    color: #62788e;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .industry-workflow-section {
    background: #FFFFFF;
  }

  .industry-faq-section {
    background: linear-gradient(135deg, #f5f9fd 0%, #f9fafb 100%);
  }

  /* CTA Section */
  .industry-cta-section {
    padding: 56px 1.5rem;
    background: linear-gradient(135deg, #0B1F44 0%, #102A43 50%, #1E3A5F 100%);
    color: #FFFFFF;
  }

  .cta-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-content h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .cta-content p {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 28px;
    background: #22D3EE;
    color: #0B1F44;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(34, 211, 238, 0.25);
  }

  .cta-button:hover {
    background: #06B6D4;
    box-shadow: 0 4px 12px rgba(34, 211, 238, 0.35);
  }

  @media (max-width: 768px) {
    .industry-section {
      padding: 48px 1.5rem;
    }

    .section-header {
      margin-bottom: 28px;
    }

    .challenges-grid,
    .solutions-grid {
      gap: 16px;
    }

    .capabilities-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .hero-ctas {
      flex-direction: column;
      gap: 10px;
    }

    .cta-primary,
    .cta-secondary {
      width: 100%;
      justify-content: center;
    }

    .industry-cta-section {
      padding: 48px 1.5rem;
    }

    .cta-content h2 {
      margin-bottom: 0.8rem;
    }

    .cta-content p {
      margin-bottom: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .challenges-grid,
    .solutions-grid,
    .capabilities-grid {
      grid-template-columns: 1fr;
    }

    .industry-hero {
      padding: 48px 1.5rem;
    }

    .industry-hero-content h1 {
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      margin-bottom: 0.8rem;
    }

    .hero-description {
      margin-bottom: 1.2rem;
      font-size: 0.9rem;
    }
  }
</style>
