---
/**
 * src/components/CaseStudiesGrid.astro
 * 
 * Grid display of case studies
 */

import { caseStudies } from '../data/caseStudies';
import CaseStudyCard from './CaseStudyCard.astro';

// Display all case studies with featured ones highlighted
const featuredStudies = caseStudies.filter((s) => s.featured);
const otherStudies = caseStudies.filter((s) => !s.featured);
---

<section class="case-studies-grid-section">
  <div class="grid-inner">
    <div class="grid-header">
      <h2>Our Case Studies</h2>
    </div>

    <div class="case-studies-grid">
      {/* Featured studies in top row */}
      {featuredStudies.map((study) => (
        <CaseStudyCard study={study} featured={true} />
      ))}

      {/* Other studies */}
      {otherStudies.map((study) => (
        <CaseStudyCard study={study} featured={false} />
      ))}
    </div>
  </div>
</section>

<style>
  .case-studies-grid-section {
    padding: clamp(4rem, 8vw, 6.5rem) 1.5rem;
    background: var(--bg);
  }

  .grid-inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .grid-header {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .grid-header h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0;
  }

  .case-studies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  /* Featured cards take up more space */
  .case-studies-grid :global(.case-study-card.featured) {
    grid-column: span 1;
  }

  @media (max-width: 1200px) {
    .case-studies-grid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .case-studies-grid-section {
      padding: 3rem 1rem;
    }

    .case-studies-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .grid-header h2 {
      font-size: 1.5rem;
    }
  }
</style>

