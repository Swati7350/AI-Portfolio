---
/**
 * src/components/Hero.astro
 * 
 * Premium two-column Hero section with AI-Powered Systems Pipeline
 * Left: positioning label, headline, supporting text, CTAs, and credibility indicators
 * Right: AI-Powered Systems Pipeline SVG illustration with data-flow animations
 * Bottom: Running capabilities banner (Ticker)
 */
import Ticker from './Ticker.astro';
---

<header class="hero" id="home">
  <div class="hero-container">
    <!-- Left Column: Content -->
    <div class="hero-left">
      <!-- Positioning Label -->
      <div class="hero-label">
        AI ENGINEERING | INTELLIGENT AUTOMATION | CUSTOM SOFTWARE
      </div>

      <!-- Subtle cyan accent line -->
      <div class="hero-accent-line"></div>

      <!-- Main Headline -->
      <h1 class="hero-headline">
        Engineering <span class="hero-headline-accent">AI Systems</span> That Make Businesses Work Better.
      </h1>

      <!-- Supporting Text -->
      <p class="hero-description">
        We engineer intelligent AI applications, autonomous agents, and connected software that transform complex processes into streamlined workflows—helping organisations work smarter and scale faster.
      </p>

      <!-- Partnership Labels -->
      <div class="hero-partnerships">
        <span class="partnership-label">Enterprise Partnerships</span>
        <span class="partnership-divider"></span>
        <span class="partnership-label">Technology Collaborations</span>
      </div>

    </div>

    <!-- Right Column: AI Systems Pipeline Illustration -->
    <div class="hero-right">
      <svg class="pipeline-svg" viewBox="0 0 550 490" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="AI-Powered Systems Pipeline: Understand & Extract, Analyse & Reason, Automate & Orchestrate">
        <!-- Define gradients and filters -->
        <defs>
          <!-- Glowing background effects behind pipeline -->
          <radialGradient id="glow-cyan" cx="50%" cy="50%" r="50%">
            <stop offset="0%" style="stop-color:#22B8CF;stop-opacity:0.12" />
            <stop offset="100%" style="stop-color:#22B8CF;stop-opacity:0" />
          </radialGradient>
          
          <radialGradient id="glow-blue" cx="50%" cy="50%" r="50%">
            <stop offset="0%" style="stop-color:#2563EB;stop-opacity:0.15" />
            <stop offset="100%" style="stop-color:#2563EB;stop-opacity:0" />
          </radialGradient>

          <filter id="shadow-glow">
            <feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.25" flood-color="#2563EB"/>
          </filter>

          <linearGradient id="stage-1-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#22B8CF;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#1B8EAA;stop-opacity:1" />
          </linearGradient>
          <linearGradient id="stage-2-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#2563EB;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#1D4FBF;stop-opacity:1" />
          </linearGradient>
          <linearGradient id="stage-3-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#22B8CF;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#1B8EAA;stop-opacity:1" />
          </linearGradient>

          <!-- Flow animation for connector lines -->
          <style>
            @keyframes flowAnimation {
              0% {
                stroke-dashoffset: 0;
              }
              100% {
                stroke-dashoffset: -30;
              }
            }

            @keyframes pulseGlow {
              0%, 100% {
                opacity: 0.5;
                r: 4px;
              }
              50% {
                opacity: 1;
                r: 6px;
              }
            }

            @keyframes slideInCard {
              0% {
                opacity: 0;
                transform: translateY(20px);
              }
              100% {
                opacity: 1;
                transform: translateY(0);
              }
            }

            @keyframes glowPulse {
              0%, 100% {
                opacity: 0.4;
              }
              50% {
                opacity: 0.8;
              }
            }

            .pipeline-svg {
              animation: slideInCard 0.8s ease-out;
            }

            .flow-line {
              animation: flowAnimation 2s linear infinite;
              stroke-dasharray: 30;
            }

            .pulse-dot {
              animation: pulseGlow 2s ease-in-out infinite;
            }

            .pulse-dot {
              animation: pulseGlow 2s ease-in-out infinite;
            }
            .glow-element {
              animation: glowPulse 4s ease-in-out infinite;
            }

            /* Particle animations for engineering journey */
            @keyframes particleFlow {
              0% {
                cx: 70;
                opacity: 0.3;
              }
              50% {
                opacity: 0.8;
              }
              100% {
                cx: 480;
                opacity: 0.2;
              }
            }

            .particle-1 {
              animation: particleFlow 4s ease-in-out infinite;
            }

            .particle-2 {
              animation: particleFlow 4s ease-in-out infinite 0.8s;
            }

            .particle-3 {
              animation: particleFlow 4s ease-in-out infinite 1.6s;
            }

            /* Node glow animation */
            @keyframes nodeGlowPulse {
              0%, 100% {
                stroke-width: 1.5;
                opacity: 0.2;
              }
              50% {
                stroke-width: 2;
                opacity: 0.5;
              }
            }

            .node-glow {
              animation: nodeGlowPulse 3s ease-in-out infinite;
            }
          </style>
        </defs>

        <!-- Ambient glow elements behind pipeline -->
        <circle class="glow-element" cx="120" cy="150" r="80" fill="url(#glow-cyan)"/>
        <circle class="glow-element" cx="280" cy="120" r="100" fill="url(#glow-blue)"/>
        <circle class="glow-element" cx="430" cy="160" r="80" fill="url(#glow-cyan)"/>

        <!-- Title -->
        <text x="255" y="35" font-size="22" font-weight="500" text-anchor="middle" fill="#FFFFFF" fill-opacity="0.9" style="paint-order:stroke;stroke:#075BEE;stroke-width:0.5px;letter-spacing:0.2px;font-family:Inter,sans-serif">
          Smarter Systems - Meaningful Business Impact
        </text>

        <!-- Stage 1: Understand & Extract -->
        <g filter="url(#shadow-glow)">
          <!-- Card background with enhanced shadow -->
          <rect x="20" y="75" width="150" height="140" rx="14" fill="#F1F6FB" stroke="#22B8CF" stroke-width="2.5" opacity="0.95"/>
          
          <!-- Icon area -->
          <rect x="40" y="92" width="110" height="56" rx="10" fill="url(#stage-1-gradient)"/>
          
          <!-- Clipboard with magnifying glass icon -->
          <svg x="55" y="102" width="80" height="40" viewBox="0 0 80 40" xmlns="http://www.w3.org/2000/svg">
            <!-- Clipboard -->
            <rect x="10" y="6" width="32" height="28" rx="2" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <!-- Clipboard clip -->
            <rect x="18" y="2" width="8" height="6" rx="1" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <!-- Checkmarks -->
            <path d="M 16 14 L 18 16 L 22 12" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M 16 20 L 18 22 L 22 18" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M 16 26 L 18 28 L 22 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <!-- Lines -->
            <line x1="26" y1="14" x2="38" y2="14" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="26" y1="20" x2="38" y2="20" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="26" y1="26" x2="35" y2="26" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
            <!-- Magnifying glass -->
            <circle cx="54" cy="24" r="10" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M 62 32 L 70 40" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          
          <!-- Text -->
          <text x="95" y="165" font-size="15.5" font-weight="600"
                text-anchor="middle" fill="#0B1F44"
                font-family="Inter,sans-serif">
            Understand
          </text>
          <text x="95" y="179" font-size="15.5" font-weight="600"
                text-anchor="middle" fill="#0B1F44"
                font-family="Inter,sans-serif">
            Business First
          </text>
          
          <!-- Supporting line -->
          <text x="95" y="200" font-size="11" text-anchor="middle" fill="#64748B" font-weight="400" font-family="Inter,sans-serif">
            Goals · Workflows
          </text>
          <text x="95" y="210" font-size="11" text-anchor="middle" fill="#64748B" font-weight="400" font-family="Inter,sans-serif">
            · Bottlenecks
          </text>
        </g>

        <!-- Arrow connector 1 with animated flow -->
        <g>
          <defs>
            <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
              <polygon points="0 0, 10 3, 0 6" fill="#22B8CF"/>
            </marker>
          </defs>
          <path class="flow-line" d="M 170 150 Q 215 150 275 150" fill="none" stroke="#22B8CF" stroke-width="3" marker-end="url(#arrowhead)"/>
          <circle class="pulse-dot" cx="170" cy="150" r="5" fill="#22B8CF"/>
        </g>

        <!-- Stage 2: Analyse & Reason -->
        <g filter="url(#shadow-glow)">
          <!-- Card background with enhanced shadow -->
          <rect x="195" y="75" width="150" height="140" rx="14" fill="#F1F6FB" stroke="#2563EB" stroke-width="2.5" opacity="0.95"/>
          
          <!-- Icon area -->
          <rect x="215" y="92" width="110" height="56" rx="10" fill="url(#stage-2-gradient)"/>
          
          <!-- Three interconnected modular cubes (isometric) -->
          <svg x="230" y="102" width="80" height="40" viewBox="0 0 80 40" xmlns="http://www.w3.org/2000/svg">
            <!-- Left cube (front-left) -->
            <g fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <!-- Front face -->
              <rect x="6" y="12" width="12" height="12"/>
              <!-- Top face -->
              <polygon points="6,12 12,6 24,6 18,12"/>
              <!-- Right face -->
              <polygon points="18,12 24,6 24,18 18,24"/>
            </g>
            
            <!-- Center cube (larger, middle) -->
            <g fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <!-- Front face -->
              <rect x="30" y="8" width="14" height="14"/>
              <!-- Top face -->
              <polygon points="30,8 37,2 51,2 44,8"/>
              <!-- Right face -->
              <polygon points="44,8 51,2 51,16 44,22"/>
            </g>
            
            <!-- Right cube (front-right) -->
            <g fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <!-- Front face -->
              <rect x="54" y="12" width="12" height="12"/>
              <!-- Top face -->
              <polygon points="54,12 60,6 72,6 66,12"/>
              <!-- Right face -->
              <polygon points="66,12 72,6 72,18 66,24"/>
            </g>
            
            <!-- Connecting lines between cubes - geometric and clean -->
            <line x1="18" y1="15" x2="30" y2="15" stroke="white" stroke-width="1.3"/>
            <line x1="44" y1="15" x2="54" y2="15" stroke="white" stroke-width="1.3"/>
            <!-- Vertical connectors from center cube to other cubes -->
            <line x1="15" y1="20" x2="24" y2="16" stroke="white" stroke-width="1" opacity="0.6"/>
            <line x1="51" y1="16" x2="60" y2="20" stroke="white" stroke-width="1" opacity="0.6"/>
          </svg>
          
          <!-- Text -->
          <text x="270" y="166" font-size="17" font-weight="700" text-anchor="middle" fill="#0B1F44" font-family="Inter,sans-serif">
            Engineer
          </text>
          <text x="270" y="182" font-size="17" font-weight="700" text-anchor="middle" fill="#0B1F44" font-family="Inter,sans-serif">
            Solutions
          </text>
          
          <!-- Supporting line -->
          <text x="270" y="200" font-size="11" text-anchor="middle" fill="#64748B" font-weight="400" font-family="Inter,sans-serif">
            AI Solutions · Existing
          </text>
          <text x="270" y="210" font-size="11" text-anchor="middle" fill="#64748B" font-weight="400" font-family="Inter,sans-serif">
            Systems
          </text>
        </g>

        <!-- Arrow connector 2 with animated flow -->
        <g>
          <path class="flow-line" d="M 345 150 Q 390 150 450 150" fill="none" stroke="#22B8CF" stroke-width="3" marker-end="url(#arrowhead)"/>
          <circle class="pulse-dot" cx="345" cy="150" r="5" fill="#22B8CF"/>
        </g>

        <!-- Stage 3: Automate & Orchestrate -->
        <g filter="url(#shadow-glow)">
          <!-- Card background with enhanced shadow -->
          <rect x="370" y="75" width="150" height="140" rx="14" fill="#F1F6FB" stroke="#22B8CF" stroke-width="2.5" opacity="0.95"/>
          
          <!-- Icon area -->
          <rect x="390" y="92" width="110" height="56" rx="10" fill="url(#stage-3-gradient)"/>
          
          <!-- Circular workflow nodes with directional arrows -->
          <svg x="405" y="102" width="80" height="40" viewBox="0 0 80 40" xmlns="http://www.w3.org/2000/svg">
            <!-- Center node -->
            <circle cx="40" cy="20" r="5.5" fill="white" stroke="white" stroke-width="0.5"/>
            
            <!-- Top node -->
            <circle cx="40" cy="5" r="4" fill="none" stroke="white" stroke-width="1.4"/>
            
            <!-- Bottom-right node -->
            <circle cx="62" cy="28" r="4" fill="none" stroke="white" stroke-width="1.4"/>
            
            <!-- Bottom-left node -->
            <circle cx="18" cy="28" r="4" fill="none" stroke="white" stroke-width="1.4"/>
            
            <!-- Prominent directional arrows from center to nodes -->
            <!-- Arrow to top -->
            <line x1="40" y1="25" x2="40" y2="10" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
            <polygon points="40,6 37.5,10.5 42.5,10.5" fill="white"/>
            
            <!-- Arrow to bottom-right (curved path) -->
            <line x1="52" y1="25" x2="60" y2="32" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
            <polygon points="63,34 57.5,31 59,25.5" fill="white"/>
            
            <!-- Arrow to bottom-left (curved path) -->
            <line x1="28" y1="25" x2="20" y2="32" stroke="white" stroke-width="1.3" stroke-linecap="round"/>
            <polygon points="17,34 22.5,31 21,25.5" fill="white"/>
            
            <!-- Circular flow path accent (more visible) -->
            <circle cx="40" cy="20" r="11" fill="none" stroke="white" stroke-width="1.1" opacity="0.5" stroke-dasharray="1.5,2"/>
          </svg>
          
          <!-- Text -->
          <text x="445" y="166" font-size="17" font-weight="700" text-anchor="middle" fill="#0B1F44" font-family="Inter,sans-serif">
            Orchestrate
          </text>
          <text x="445" y="182" font-size="17" font-weight="700" text-anchor="middle" fill="#0B1F44" font-family="Inter,sans-serif">
            Operations
          </text>
          
          <!-- Supporting line -->
          <text x="445" y="200" font-size="11" text-anchor="middle" fill="#64748B" font-weight="400" font-family="Inter,sans-serif">
            Process Automation
          </text>
          <text x="445" y="210" font-size="11" text-anchor="middle" fill="#64748B" font-weight="400" font-family="Inter,sans-serif">
            · Workflow Orchestration
          </text>
        </g>

        <!-- Engineering Journey: Shipped. Scaled. Sustained. -->
        <g class="journey-section">
          <text x="275" y="265" font-size="25" font-weight="700" text-anchor="middle" fill="#FFFFFF" font-family="Inter,sans-serif">
            Shipped. Scaled. Sustained.
          </text>
          <text x="275" y="290" font-size="14" font-weight="400" text-anchor="middle" fill="#D6E6FF" font-family="Inter,sans-serif">
            Engineered for real-world operations and built to evolve with your business.
          </text>

          <!-- Define gradients for the connecting line and nodes -->
          <defs>
            <linearGradient id="journey-line-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" style="stop-color:#22D3EE;stop-opacity:0.75" />
              <stop offset="50%" style="stop-color:#2563EB;stop-opacity:0.75" />
              <stop offset="100%" style="stop-color:#22D3EE;stop-opacity:0.75" />
            </linearGradient>
            <filter id="node-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
              <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>

          <!-- Continuous connecting line: cyan → electric blue → cyan.
               Nodes align with the exact centre of each stage below. -->
          <g class="journey-connector" fill="none" stroke-linecap="round">
            <path d="M 30 325 H 100" stroke="#22D3EE" stroke-width="4" opacity="1"/>
            <path d="M 100 325 H 275" stroke="#3B82F6" stroke-width="4" opacity="1"/>
            <path d="M 275 325 H 450" stroke="#22D3EE" stroke-width="4" opacity="1"/>
            <path d="M 450 325 H 520" stroke="#22D3EE" stroke-width="4" opacity="1"/>
          </g>

          <!-- Three prominent, fixed anchor nodes -->
          <g class="journey-anchor-nodes">
            <circle cx="100" cy="325" r="11" fill="#22D3EE" opacity="0.18" filter="url(#node-glow)"/>
            <circle cx="100" cy="325" r="6.5" fill="#22D3EE" stroke="#A5F3FC" stroke-width="1.5"/>

            <circle cx="275" cy="325" r="11" fill="#3B82F6" opacity="0.22" filter="url(#node-glow)"/>
            <circle cx="275" cy="325" r="6.5" fill="#3B82F6" stroke="#BFDBFE" stroke-width="1.5"/>

            <circle cx="450" cy="325" r="11" fill="#22D3EE" opacity="0.18" filter="url(#node-glow)"/>
            <circle cx="450" cy="325" r="6.5" fill="#22D3EE" stroke="#A5F3FC" stroke-width="1.5"/>
          </g>

          <!-- Animated particles along the line -->
          <circle class="journey-particle" r="2.2" fill="#FFFFFF" opacity="0.8">
            <animateMotion dur="5s" repeatCount="indefinite" path="M 30 325 H 520"/>
          </circle>
          <circle class="journey-particle" r="1.8" fill="#67E8F9" opacity="0.6">
            <animateMotion dur="5s" begin="-1.67s" repeatCount="indefinite" path="M 30 325 H 520"/>
          </circle>
          <circle class="journey-particle" r="1.5" fill="#93C5FD" opacity="0.5">
            <animateMotion dur="5s" begin="-3.33s" repeatCount="indefinite" path="M 30 325 H 520"/>
          </circle>

          <!-- Column 1: Built & Delivered (x=30 to x=170, width=140) -->
          <g class="journey-stage">
            <!-- Icon centered in column: cx=100, cyan colour -->
            <g transform="translate(80.8, 340) scale(1.35)" fill="none" stroke="#22D3EE" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/>
              <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6.05 11A22 22 0 0 1 12 15z"/>
              <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
              <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
            </g>
            <!-- Heading -->
            <text x="100" y="420" font-size="16" font-weight="500" text-anchor="middle" fill="#FFFFFF" font-family="Inter,sans-serif">
              Built &amp;
            </text>
            <text x="100" y="437" font-size="16" font-weight="500" text-anchor="middle" fill="#FFFFFF" font-family="Inter,sans-serif">
              Delivered
            </text>
            <!-- Description with max-width constraint via tspan wrapping -->
            <text x="100" y="459" font-size="13" font-weight="400" text-anchor="middle" fill="#C0D9FF" fill-opacity="0.85" class="journey-desc" font-family="Inter,sans-serif" line-height="1.5">
              <tspan x="100" dy="0">Production-ready solutions</tspan>
              <tspan x="100" dy="16">for real-world workflows</tspan>
            </text>
          </g>

          <!-- Column 2: Growth & Expansion (x=190 to x=360, width=170, center=275) -->
          <g class="journey-stage">
            <!-- Icon centered in column: cx=275, electric blue colour -->
            <g transform="translate(255.8, 340) scale(1.35)" fill="none" stroke="#60A5FA" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
              <polyline points="17 6 23 6 23 12"/>
            </g>
            <!-- Heading -->
            <text x="275" y="420" font-size="16" font-weight="500" text-anchor="middle" fill="#FFFFFF" font-family="Inter,sans-serif">
              Growth &amp;
            </text>
            <text x="275" y="437" font-size="16" font-weight="500" text-anchor="middle" fill="#FFFFFF" font-family="Inter,sans-serif">
              Expansion
            </text>
            <!-- Description with max-width constraint via tspan wrapping -->
            <text x="275" y="459" font-size="13" font-weight="400" text-anchor="middle" fill="#C0D9FF" fill-opacity="0.85" class="journey-desc" font-family="Inter,sans-serif" line-height="1.5">
              <tspan x="275" dy="0">Scales with evolving</tspan>
              <tspan x="275" dy="16">business needs</tspan>
            </text>
          </g>

          <!-- Column 3: Long-term Reliability (x=380 to x=520, width=140, center=450) -->
          <g class="journey-stage">
            <!-- Icon centered in column: cx=450, cyan colour -->
            <g transform="translate(430.8, 340) scale(1.35)" fill="none" stroke="#22D3EE" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </g>
            <!-- Heading -->
            <text x="450" y="420" font-size="16" font-weight="500" text-anchor="middle" fill="#FFFFFF" font-family="Inter,sans-serif">
              Long-term
            </text>
            <text x="450" y="437" font-size="16" font-weight="500" text-anchor="middle" fill="#FFFFFF" font-family="Inter,sans-serif">
              Reliability
            </text>
            <!-- Description with max-width constraint via tspan wrapping -->
            <text x="450" y="459" font-size="13" font-weight="400" text-anchor="middle" fill="#C0D9FF" fill-opacity="0.85" class="journey-desc" font-family="Inter,sans-serif" line-height="1.5">
              <tspan x="450" dy="0">Reliable, maintained</tspan>
              <tspan x="450" dy="16">and supported</tspan>
            </text>
          </g>
        </g>
      </svg>
    </div>
  </div>

  <!-- Subtle connected-system paths behind the content -->
  <svg class="hero-orbits" viewBox="0 0 1600 900" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <filter id="orbit-soft-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
      <linearGradient id="orbit-line-blue" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#22D3EE" stop-opacity="0.08"/>
        <stop offset="0.5" stop-color="#62A8FF" stop-opacity="0.42"/>
        <stop offset="1" stop-color="#22D3EE" stop-opacity="0.12"/>
      </linearGradient>
    </defs>
