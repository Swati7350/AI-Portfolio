---
/**
 * src/components/Ticker.astro
 * 
 * Scrolling capabilities banner
 * Displays a continuous loop of capabilities
 */

const capabilities = [
  "AI & BUSINESS AUTOMATION",
  "AI AGENTS",
  "VOICE AGENTS",
  "RAG & DOCUMENT SEARCH",
  "SOCIAL MEDIA AUTOMATION",
  "WEBSITE DEVELOPMENT",
];
---

<section class="ticker" aria-label="Our capabilities">
  <div class="ticker-track">
    <div class="ticker-group">
      {
        capabilities.map((cap, idx) => (
          <>
            <span>{cap}</span>
            {idx < capabilities.length - 1 && (
              <span class="ticker-separator" aria-hidden="true">
                ✳
              </span>
            )}
          </>
        ))
      }
    </div>
    <div class="ticker-group" aria-hidden="true">
      {
        capabilities.map((cap, idx) => (
          <>
            <span>{cap}</span>
            {idx < capabilities.length - 1 && (
              <span class="ticker-separator">✳</span>
            )}
          </>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ticker {
    overflow: hidden;
    background: linear-gradient(180deg, rgba(7, 91, 238, 0.08) 0%, rgba(7, 91, 238, 0.15) 100%);
    border-top: 1px solid rgba(34, 211, 238, 0.25);
    border-bottom: none;
    padding: 0.85rem 1.5rem;
    margin: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .ticker-track {
    display: flex;
    gap: 2rem;
    animation: scroll-left 30s linear infinite;
    align-items: center;
  }

  .ticker-group {
    display: flex;
    gap: 2rem;
    flex-shrink: 0;
    white-space: nowrap;
    align-items: center;
  }

  .ticker-group span {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #D6E6FF;
    line-height: 1.2;
  }

  .ticker-separator {
    color: #22D3EE;
    opacity: 0.7;
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .ticker {
      padding: 0.85rem 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .ticker {
      padding: 0.7rem 1.5rem;
    }

    .ticker-group span {
      font-size: 0.75rem;
    }

    .ticker-track {
      gap: 1rem;
    }

    .ticker-group {
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .ticker {
      padding: 0.7rem 1rem;
    }

    .ticker-group span {
      font-size: 0.65rem;
    }
  }
</style>
