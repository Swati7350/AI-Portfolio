---
/**
 * src/pages/insights/index.astro
 * 
 * Insights & Blogs landing page
 */

import MainLayout from '../../layouts/MainLayout.astro';
import { pages } from '../../data/site';
import InsightsHero from '../../components/InsightsHero.astro';
import ArticleFilters from '../../components/ArticleFilters.astro';
import ArticlesGrid from '../../components/ArticlesGrid.astro';
import InsightsCTA from '../../components/InsightsCTA.astro';

const insightsMeta = {
  title: 'Insights & Blogs | Paras AI Innovations',
  description: 'Explore practical AI insights, technical guides, and perspectives on intelligent automation, machine learning and digital product engineering.',
  ogImage: pages.home.ogImage,
};
---

<MainLayout
  title={insightsMeta.title}
  description={insightsMeta.description}
  ogImage={insightsMeta.ogImage}
>
  <InsightsHero />
  <ArticleFilters />
  <ArticlesGrid />
  <InsightsCTA />
</MainLayout>

<style>
  /* Additional page-level styles if needed */
</style>
