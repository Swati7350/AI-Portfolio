---
/**
 * src/layouts/MainLayout.astro
 * 
 * Main layout component containing:
 * - Common page structure
 * - Navigation
 * - Footer
 * - Global styles
 * - SEO metadata
 */

import '../styles/base.css';
import { site, PageMeta, pages } from '../data/site';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  ogImage = site.logo,
  ogType = 'website',
  canonical,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical ? new URL(canonical, site.url) : new URL(Astro.url.pathname, site.url);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <title>{title}</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="512x512" href={site.favicon} />
    <link rel="shortcut icon" href={site.favicon} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Robots -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, site.url)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, site.url)} />

    <!-- Font preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Google Analytics -->
    <script async src=`https://www.googletagmanager.com/gtag/js?id=${site.analytics.gaId}`></script>
    <script is:inline define:vars={{ gaId: site.analytics.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>

  <body>
    <!-- Skip to main content (accessibility) -->
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- Navigation -->
    <Navbar />

    <!-- Main content -->
    <main id="main" role="main">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }
</style>
