---
/**
 * src/pages/case-studies/[id].astro
 * 
 * Individual case study detail page
 */

import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import CaseStudiesCTA from '../../components/CaseStudiesCTA.astro';
import { getStudyById, caseStudies } from '../../data/caseStudies';

// Generate static paths for all case studies
export async function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { id: study.id },
    props: { study },
  }));
}

const { id } = Astro.params;
const { study } = Astro.props;

if (!study) {
  return Astro.redirect('/case-studies/');
}

const pageTitle = `${study.title} | Case Study | Paras AI Innovations`;
const pageDescription = study.shortDescription;
---

<MainLayout title={pageTitle} description={pageDescription}>
  <article class="case-study-detail">
    <!-- Hero Section -->
    <section class="detail-hero">
      <div class="hero-inner">
        <span class="hero-category">{study.category}</span>
        {study.projectType === 'internal' && (
          <span class="hero-badge">Internal Project / Technical Demonstration</span>
        )}
        <h1 class="hero-title">{study.title}</h1>
        <p class="hero-description">{study.shortDescription}</p>
      </div>
    </section>

    <!-- Main Content -->
    <section class="detail-content">
      <div class="content-inner">
        <div class="content-grid">
          <!-- Left Column: Main Content -->
          <div class="content-main">
            <!-- Problem Section -->
            <div class="content-block">
              <h2>The Challenge</h2>
              <p>{study.problem}</p>
            </div>

            <!-- Solution Section -->
            <div class="content-block">
              <h2>Our Approach</h2>
              <p>{study.solution}</p>
            </div>

            <!-- Architecture Section -->
            <div class="content-block">
              <h2>System Architecture</h2>
              <p>{study.architecture}</p>
            </div>

            <!-- Implementation Section -->
            <div class="content-block">
              <h2>Implementation</h2>
              <p>{study.implementation}</p>
            </div>
          </div>

          <!-- Right Column: Sidebar -->
          <aside class="content-sidebar">
            <!-- Key Capabilities -->
            <div class="sidebar-block">
              <h3>Key Capabilities</h3>
              <ul class="capabilities-list">
                {study.keyCapabilities.map((capability) => (
                  <li>{capability}</li>
                ))}
              </ul>
            </div>

            <!-- Technology Stack -->
            <div class="sidebar-block">
              <h3>Technology Stack</h3>
              <div class="tech-stack">
                {study.techStack.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
            </div>

            <!-- Related Capabilities -->
            <div class="sidebar-block">
              <h3>Related Capabilities</h3>
              <ul class="capabilities-list">
                {study.relatedCapabilities.map((capability) => (
                  <li>{capability}</li>
                ))}
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </article>

  <!-- CTA Section -->
  <CaseStudiesCTA />
</MainLayout>

<style>
  .case-study-detail {
    flex: 1;
  }

  /* Hero Section */
  .detail-hero {
    padding: clamp(4rem, 8vw, 6rem) 1.5rem;
    background: linear-gradient(135deg, #f5f9fd 0%, #f0f7ff 100%);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-category {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(22, 119, 255, 0.08);
    border: 1px solid rgba(22, 119, 255, 0.2);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--blue);
    width: fit-content;
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.055em;
    color: var(--text-primary);
    margin: 0;
  }

  .hero-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
    max-width: 700px;
  }

  /* Content Section */
  .detail-content {
    padding: clamp(4rem, 8vw, 6.5rem) 1.5rem;
    background: var(--bg);
  }

  .content-inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .content-main {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .content-block h2 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .content-block p {
    font-size: 0.975rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Sidebar */
  .content-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .sidebar-block {
    padding: 1.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .sidebar-block h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .capabilities-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .capabilities-list li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    padding-left: 1.25rem;
    position: relative;
  }

  .capabilities-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--blue);
    font-weight: 700;
  }

  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tech-tag {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(22, 119, 255, 0.08);
    border: 1px solid rgba(22, 119, 255, 0.2);
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue);
    width: fit-content;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .content-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .detail-hero {
      padding: 3rem 1rem;
    }

    .hero-title {
      font-size: 1.85rem;
    }

    .hero-description {
      font-size: 1rem;
    }

    .detail-content {
      padding: 2.5rem 1rem;
    }

    .content-main {
      gap: 2.5rem;
    }

    .content-block h2 {
      font-size: 1.25rem;
    }

    .sidebar-block {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 1.5rem;
    }

    .content-main {
      gap: 2rem;
    }

    .content-block h2 {
      font-size: 1.15rem;
    }

    .sidebar-block {
      padding: 1.25rem;
    }
  }
</style>

