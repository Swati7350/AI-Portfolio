---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page Not Found | Paras AI Innovations"
  description="The page you are looking for may have moved or is no longer available."
  noIndex={true}
>
  <main class="container" style="min-height: 60vh; display: grid; place-content: center; text-align: center; padding: 100px 24px;">
    <p style="color: #FF432B; font-weight: 700; letter-spacing: .12em;">ERROR 404</p>
    <h1 style="font-size: clamp(2.5rem, 6vw, 5rem); margin: 12px 0;">This page doesn't exist.</h1>
    <p style="max-width: 560px; margin: 0 auto 28px;">The page may have been removed, renamed or is temporarily unavailable.</p>
    <p><a class="tf-btn" href="/">Return to homepage <span aria-hidden="true">↗</span></a></p>
  </main>
</BaseLayout>
