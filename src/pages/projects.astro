---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/projects.css";

const projects = [
  {
    title: "Document Intelligence System",
    image: "/images/projects/document-intelligence.jpg",
    alt: "Document intelligence application processing business documents on a laptop",
    description: "Transform business documents into searchable, actionable knowledge with AI. Upload documents, extract key information and get contextual answers from your files through an intelligent document interface.",
    href: "/projects/document-intelligence/"
  },
  {
    title: "Invoice Reconciliation",
    image: "/images/projects/invoice-reconciliation.jpg",
    alt: "Invoice reconciliation workflow matching purchase orders, invoices and goods receipts",
    description: "An AI-powered reconciliation system that processes invoices and receipts, matches financial information, and highlights discrepancies. Reduce manual verification and make invoice reconciliation faster and more accurate.",
    href: "/projects/invoice-reconciliation/"
  },
  {
    title: "Intelligent WhatsApp Conversations",
    image: "/images/projects/whatsapp-conversations.jpg",
    alt: "AI agent assisting a customer through a WhatsApp conversation",
    description: "Deploy AI-powered agents that understand customer inquiries, retrieve business information, generate responses and automate everyday business processes — directly through WhatsApp.",
    href: "/projects/whatsapp-ai-agent/"
  }
];
const pageStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://parasaiinnovations.com/" },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://parasaiinnovations.com/projects/" }
  ]
};
---
<BaseLayout 
  title="Our Projects | Paras AI Innovations"
  description="Explore our portfolio of AI applications, document intelligence systems, and custom software solutions that transform business operations and drive growth."
 structuredData={pageStructuredData}>
  <main class="projects-page">
    <section class="projects-hero">
      <div class="projects-hero-background" aria-hidden="true"></div>
      <div class="container projects-hero-content">
        <div class="projects-eyebrow effectFade fadeUp"><span></span> OUR PORTFOLIO <span></span></div>
        <h1 class="projects-title effectFade fadeUp">Selected Work.<br />Built to Solve <em>Real Problems.</em></h1>
        <p class="projects-intro effectFade fadeUp">
          Explore AI applications, intelligent automation and digital experiences built to solve practical business challenges.
        </p>
      </div>
    </section>

    <section class="projects-list" aria-label="Selected projects">
      <div class="container">
        <div class="projects-grid">
          {projects.map((project) => (
            <article class="project-card effectFade fadeUp">
              <a class="project-image" href={project.href} target={project.href.startsWith("https://") ? "_blank" : undefined} rel="noreferrer" aria-label={`Explore ${project.title}`}>
                <img src={project.image} alt={project.alt} loading="lazy" decoding="async" />
                <span class="image-action">Explore Project <span aria-hidden="true">↗</span></span>
              </a>
              <div class="project-content">
                <h2>{project.title}</h2>
                <p>{project.description}</p>
                <a class="project-readmore" href={project.href} target={project.href.startsWith("https://") ? "_blank" : undefined} rel="noreferrer">
                  Read More <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="projects-cta" aria-labelledby="projects-cta-title">
      <div class="container">
        <div class="projects-cta-inner">
          <div class="projects-cta-copy">
            <span class="cta-eyebrow"><i></i> READY TO BUILD SOMETHING?</span>
            <h2 id="projects-cta-title">Ideas are everywhere.<br />Let's <em>engineer yours.</em></h2>
            <p>From intelligent AI applications to custom software, let's turn your next challenge into a working solution.</p>
            <div class="cta-services" aria-label="Our capabilities">
              <span>AI ENGINEERING</span><b>·</b><span>SOFTWARE</span><b>·</b><span>AUTOMATION</span>
            </div>
          </div>
          <div class="projects-cta-visual" aria-hidden="true">
            <img src="/images/projects/cta-coral-ribbon.png" alt="" loading="lazy" />
          </div>
          <a class="tf-btn projects-cta-button" href="/contact/">Start a Project <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>

  
</BaseLayout>
