---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/project-detail.css";

const tags = ["Invoice Processing", "Receipt Matching", "AI Reconciliation", "Discrepancy Detection"];
const challenge = [
  "Invoice information spread across multiple documents.",
  "Time-consuming manual data verification.",
  "Difficulty identifying mismatched amounts and details.",
  "Delays in reviewing and approving transactions."
];
const solution = [
  "Automated extraction of invoice and receipt information.",
  "Matching of corresponding financial records.",
  "Identification of mismatches and discrepancies.",
  "Faster reconciliation with clearer verification results."
];
const pageStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://parasaiinnovations.com/" },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://parasaiinnovations.com/projects/" },
    { "@type": "ListItem", "position": 3, "name": "Invoice Reconciliation", "item": "https://parasaiinnovations.com/projects/invoice-reconciliation/" }
  ]
};
---
<BaseLayout
  title="Invoice Reconciliation | Paras AI Innovations"
  description="An AI-powered reconciliation system that processes invoices and receipts, matches financial information, and highlights discrepancies. Reduce manual verification and make invoice reconciliation faster and more accurate."
  ogImage="/images/projects/invoice-reconciliation-3way-matching.png"
 structuredData={pageStructuredData}>
  <main class="project-detail-page">
    <section class="project-detail-hero" aria-labelledby="project-title">
      <div class="project-hero-orbit project-hero-orbit-top" aria-hidden="true"></div>
      <div class="project-hero-orbit project-hero-orbit-bottom" aria-hidden="true"></div>
      <div class="container project-hero-grid">
        <div class="project-hero-copy">
          <a class="project-back-link effectFade fadeUp" href="/projects/">
            <span aria-hidden="true">←</span> All Recent Projects
          </a>
          <h1 id="project-title" class="effectFade fadeUp">Invoice<br />Reconciliation</h1>
          <span class="project-title-underline" aria-hidden="true"></span>
          <p class="project-hero-description effectFade fadeUp">
            An AI-powered reconciliation system that processes invoices and receipts, matches financial
            information, and highlights discrepancies. Reduce manual verification and make invoice
            reconciliation faster and more accurate.
          </p>
          <ul class="project-tags effectFade fadeUp" aria-label="Project capabilities">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <a class="project-text-link effectFade fadeUp" href="#project-overview">
            Explore the project <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="project-hero-visual effectFade fadeUp">
          <img
            src="/images/projects/invoice-reconciliation-3way-matching.png"
            alt="Invoice reconciliation diagram matching a purchase order, invoice and goods receipt"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section class="project-overview section-space" id="project-overview" aria-labelledby="overview-title">
      <div class="container">
        <div class="project-section-heading effectFade fadeUp">
          <span class="project-eyebrow">Project Overview</span>
          <h2 id="overview-title">From manual invoice checking to <em>intelligent reconciliation.</em></h2>
          <p>
            Businesses process invoices and receipts from multiple sources. Manually comparing amounts,
            quantities and transaction details takes time and makes discrepancies harder to identify.
            We engineered an AI-powered system to streamline this reconciliation process.
          </p>
        </div>

        <div class="challenge-solution-grid">
          <article class="challenge-card effectFade fadeUp">
            <div class="overview-card-copy">
              <span class="card-eyebrow">The Challenge</span>
              <h3>Manual invoice and receipt reconciliation</h3>
              <p class="overview-card-description">
                Businesses handle invoices and receipts from multiple sources. Comparing financial
                information manually is time-consuming and increases the possibility of overlooking discrepancies.
              </p>
              <ul>
                {challenge.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </article>

          <div class="engineer-connector" aria-label="Engineered solution">
            <span class="connector-line"></span>
            <span class="connector-arrow" aria-hidden="true">→</span>
            <span class="connector-label">Engineer</span>
          </div>

          <article class="solution-card effectFade fadeUp">
            <div class="overview-card-copy">
              <span class="card-eyebrow">The Solution</span>
              <h3>An AI-powered invoice reconciliation system</h3>
              <p class="overview-card-description">
                We developed an intelligent system that extracts financial information from invoices and
                receipts, compares corresponding records and highlights discrepancies for easier verification.
              </p>
              <ul>
                {solution.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="finished-experience section-space" id="finished-experience" aria-labelledby="experience-title">
      <div class="container experience-layout">
        <div class="experience-copy effectFade fadeUp">
          <span class="project-eyebrow">Product Experience</span>
          <h2 id="experience-title">Explore the Invoice Reconciliation</h2>
          <p>
            An AI-powered application that extracts invoice and receipt information, compares financial
            records and presents matching results and discrepancies through a streamlined interface.
          </p>
        </div>
        <span class="experience-live-demo-btn" aria-disabled="true" title="Live demo URL has not been provided">
          Explore Live Demo <span aria-hidden="true">↗</span>
        </span>
        <div class="experience-preview effectFade fadeUp">
          <img
            src="/images/projects/invoice-reconciliation-app-preview.png"
            alt="Automated Invoice Reconciliation application showing invoice and delivery receipt upload, comparison and review steps"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="project-specific-cta" aria-labelledby="project-cta-title">
      <div class="project-cta-inner">
        <div class="project-cta-content">
          <div class="project-cta-copy">
            <h2 id="project-cta-title">Still spending hours reconciling invoices manually?</h2>
            <p>Let's build intelligent financial workflows that reduce manual verification, identify discrepancies and streamline your business operations.</p>
            <a class="project-cta-button" href="/contact/?service=AI%20Applications%20%26%20Business%20Automations">
              Discuss Your Project <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="project-cta-visual" aria-hidden="true"></div>
        </div>
      </div>
    </section>
  </main>
  <script>
    const projectContactParams = new URLSearchParams(window.location.search);
    projectContactParams.set("service", "AI Applications & Business Automations");
    projectContactParams.set("landing_page", `${window.location.origin}${window.location.pathname}${window.location.search}`);
    document.querySelectorAll('.project-cta-button, a[href^="/contact/?service="]').forEach((link) => {
      link.setAttribute("href", `/contact/?${projectContactParams.toString()}`);
    });
  </script>
</BaseLayout>
