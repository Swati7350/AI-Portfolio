---
/**
 * src/pages/industries/logistics-supply-chain.astro
 * 
 * Logistics & Supply Chain industry page
 */
import MainLayout from '../../layouts/MainLayout.astro';
import { site } from '../../data/site';
import { industries } from '../../data/industries';
import IndustryPage from '../../components/IndustryPage.astro';

const industry = industries.find(ind => ind.id === 'logistics-supply-chain')!;
const title = `${industry.name} | AI & Automation Solutions | Paras AI Innovations`;
const description = `Logistics & Supply Chain AI solutions: Route optimization, shipment tracking, warehouse automation, and connected supply networks.`;
const canonical = new URL('/industries/logistics-supply-chain/', site.url);
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical.toString()}
>
  <IndustryPage industry={industry} />
</MainLayout>
