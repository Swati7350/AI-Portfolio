---
/**
 * src/pages/industries/healthcare.astro
 * 
 * Healthcare & Life Sciences industry page
 */
import MainLayout from '../../layouts/MainLayout.astro';
import { site } from '../../data/site';
import { industries } from '../../data/industries';
import IndustryPage from '../../components/IndustryPage.astro';

const industry = industries.find(ind => ind.id === 'healthcare')!;
const title = `${industry.name} | AI & Automation Solutions | Paras AI Innovations`;
const description = `Healthcare & Life Sciences AI solutions: AI receptionists, patient engagement automation, medical document intelligence, and connected healthcare workflows.`;
const canonical = new URL('/industries/healthcare/', site.url);
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical.toString()}
>
  <IndustryPage industry={industry} />
</MainLayout>
