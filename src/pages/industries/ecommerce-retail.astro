---
/**
 * src/pages/industries/ecommerce-retail.astro
 * 
 * Ecommerce & Retail industry page
 */
import MainLayout from '../../layouts/MainLayout.astro';
import { site } from '../../data/site';
import { industries } from '../../data/industries';
import IndustryPage from '../../components/IndustryPage.astro';

const industry = industries.find(ind => ind.id === 'ecommerce')!;
const title = `${industry.name} | AI & Automation Solutions | Paras AI Innovations`;
const description = `Ecommerce & Retail AI solutions: AI customer support, order automation, inventory management, and personalized shopping experiences.`;
const canonical = new URL('/industries/ecommerce-retail/', site.url);
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical.toString()}
>
  <IndustryPage industry={industry} />
</MainLayout>
