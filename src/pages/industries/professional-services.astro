---
/**
 * src/pages/industries/professional-services.astro
 * 
 * Professional Services industry page
 */
import MainLayout from '../../layouts/MainLayout.astro';
import { site } from '../../data/site';
import { industries } from '../../data/industries';
import IndustryPage from '../../components/IndustryPage.astro';

const industry = industries.find(ind => ind.id === 'professional-services')!;
const title = `${industry.name} | AI & Automation Solutions | Paras AI Innovations`;
const description = `Professional Services AI solutions: Project automation, client management, document automation, and business intelligence workflows.`;
const canonical = new URL('/industries/professional-services/', site.url);
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical.toString()}
>
  <IndustryPage industry={industry} />
</MainLayout>
