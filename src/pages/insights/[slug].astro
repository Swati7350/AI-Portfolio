---
/**
 * src/pages/insights/[slug].astro
 * 
 * Individual article detail page with dynamic routing
 */

import MainLayout from '../../layouts/MainLayout.astro';
import { getAllArticles, getRelatedArticles, getArticleById } from '../../data/articles';
import ArticleCard from '../../components/ArticleCard.astro';

export function getStaticPaths() {
  const articles = getAllArticles();
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: typeof getAllArticles[0];
}

const { article } = Astro.props;

if (!article) {
  return new Response('Not Found', { status: 404 });
}

const relatedArticles = getRelatedArticles(article.id, 3);
const publishDate = new Date(article.publishedDate);
const formattedDate = publishDate.toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric' 
});
---

<MainLayout
  title={article.seoTitle}
  description={article.seoDescription}
  ogImage={article.featuredImage}
  canonical={`/insights/${article.slug}/`}
>
  <article class="article-detail">
    {/* Hero with featured image */}
    <section class="article-hero">
      <div class="hero-image">
        <img 
          src={article.featuredImage} 
          alt={article.imageAlt}
          width="1200"
          height="600"
        />
      </div>
    </section>

    {/* Article content */}
    <div class="article-container">
      <div class="article-layout">
        {/* Main content */}
        <main class="article-main">
          {/* Header with metadata */}
          <header class="article-header">
            <div class="article-meta">
              <span class="meta-category">{article.category}</span>
              <span class="meta-divider">•</span>
              <time class="meta-date" datetime={article.publishedDate}>
                {formattedDate}
              </time>
              <span class="meta-divider">•</span>
              <span class="meta-reading-time">{article.readingTime} min read</span>
            </div>

            <h1 class="article-title">{article.title}</h1>

            <p class="article-lead">{article.description}</p>

            <div class="article-author">
              <div class="author-info">
                <span class="author-label">By</span>
                <span class="author-name">{article.author}</span>
              </div>
            </div>
          </header>

          {/* Article body */}
          <div class="article-body">
            <div set:html={article.content} />
          </div>
        </main>

        {/* Sidebar */}
        <aside class="article-sidebar">
          {/* Share section */}
          <div class="sidebar-section">
            <h3 class="sidebar-title">Share Article</h3>
            <div class="share-links">
              <a 
                href={`https://twitter.com/intent/tweet?url=${new URL(Astro.url.pathname, Astro.site).toString()}&text=${encodeURIComponent(article.title)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-link"
                title="Share on Twitter"
              >
                𝕏
              </a>
              <a 
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${new URL(Astro.url.pathname, Astro.site).toString()}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-link"
                title="Share on LinkedIn"
              >
                in
              </a>
            </div>
          </div>

          {/* Author section */}
          <div class="sidebar-section">
            <h3 class="sidebar-title">About Author</h3>
            <p class="sidebar-text">
              {article.author} — Technical insights and perspectives on AI engineering, business automation and software development.
            </p>
          </div>
        </aside>
      </div>

      {/* Related articles */}
      {relatedArticles.length > 0 && (
        <section class="related-articles">
          <div class="related-header">
            <h2 class="related-title">Related Articles</h2>
            <a href="/insights/" class="related-view-all">View All Articles →</a>
          </div>
          <div class="related-grid">
            {relatedArticles.map(related => (
              <ArticleCard article={related} />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</MainLayout>

<style>
  .article-detail {
    width: 100%;
  }

  .article-hero {
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .hero-image {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
    aspect-ratio: 2 / 1;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2rem;
  }

  .article-main {
    min-width: 0;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    flex-wrap: wrap;
  }

  .meta-category {
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .meta-divider {
    opacity: 0.5;
  }

  .article-title {
    margin: 0 0 1.25rem;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .article-lead {
    margin: 0 0 1.5rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .article-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .author-info {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .author-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .author-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .article-body {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-primary);
    margin-bottom: 3rem;
  }

  /* Article content styles */
  .article-body h1 {
    margin: 2.5rem 0 1.25rem;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .article-body h2 {
    margin: 2rem 0 1rem;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .article-body h3 {
    margin: 1.5rem 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .article-body h1:first-child,
  .article-body h2:first-child,
  .article-body h3:first-child {
    margin-top: 0;
  }

  .article-body p {
    margin: 0 0 1.25rem;
  }

  .article-body ul,
  .article-body ol {
    margin: 1.25rem 0;
    padding-left: 2rem;
  }

  .article-body li {
    margin: 0.5rem 0;
  }

  .article-body strong {
    font-weight: 700;
    color: var(--text-primary);
  }

  .article-body em {
    font-style: italic;
  }

  .article-body code {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.2em 0.4em;
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: 0.9em;
    color: #D64292;
  }

  .article-body pre {
    background: #1a1a1a;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .article-body pre code {
    background: transparent;
    border: none;
    padding: 0;
    color: #e0e0e0;
    font-size: 0.9rem;
  }

  .article-body blockquote {
    border-left: 4px solid var(--blue);
    padding: 1rem 0 1rem 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  .article-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .article-body th,
  .article-body td {
    text-align: left;
    padding: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .article-body th {
    background: var(--bg-secondary);
    font-weight: 700;
  }

  .article-body tr:hover {
    background: var(--bg-secondary);
  }

  .article-body a:not([class]) {
    color: var(--blue);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgba(22, 119, 255, 0.3);
    transition: all 0.2s ease;
  }

  .article-body a:not([class]):hover {
    text-decoration-color: var(--blue);
  }

  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-section {
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .sidebar-title {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .sidebar-text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .share-links {
    display: flex;
    gap: 1rem;
  }

  .share-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  @media (hover: hover) {
    .share-link:hover {
      background: var(--blue);
      color: #FFFFFF;
      border-color: var(--blue);
    }
  }

  .share-link:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .related-articles {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 2px solid var(--border);
  }

  .related-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .related-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .related-view-all {
    color: var(--blue);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  @media (hover: hover) {
    .related-view-all:hover {
      color: var(--blue-hover);
      transform: translateX(2px);
    }
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 1024px) {
    .article-layout {
      grid-template-columns: 1fr;
    }

    .article-sidebar {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 1.5rem;
    }

    .sidebar-section {
      flex: 1;
    }
  }

  @media (max-width: 768px) {
    .article-container {
      padding: 2rem 1.5rem;
    }

    .article-title {
      font-size: 2rem;
    }

    .article-body {
      font-size: 1rem;
      line-height: 1.7;
    }

    .article-body h2 {
      font-size: 1.4rem;
    }

    .related-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .article-sidebar {
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .article-container {
      padding: 1.5rem 1rem;
    }

    .article-title {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }

    .article-meta {
      font-size: 0.75rem;
    }

    .article-body {
      font-size: 0.95rem;
    }

    .article-body h2 {
      font-size: 1.2rem;
      margin: 1.5rem 0 0.75rem;
    }

    .article-body h3 {
      font-size: 1.05rem;
    }
    .article-layout {
      padding: 1rem;
    }

    .share-link {
      width: 36px;
      height: 36px;
    }

    .related-title {
      font-size: 1.25rem;
    }
  }
</style>
