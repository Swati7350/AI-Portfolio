---
/**
 * src/components/IndustriesSection.astro
 * 
 * Landing page industries section that displays industry solutions
 * with six industry cards, cross-industry capabilities and CTA.
 */

import { industries } from '../data/industries';
---

<!-- Industry Grid Section -->
<section class="industries-section" aria-labelledby="industries-section-title">
  <div class="industries-container">
    <!-- Main Heading -->
    <div class="industries-hero-content">
      <h2 class="industries-main-heading">AI & Automation Across Every Industry</h2>
      <p class="industries-description">Discover how Paras AI Innovations applies intelligent automation, AI agents, and connected systems to solve real operational challenges across diverse business sectors.</p>
    </div>

    <!-- CTA -->
    <div class="industries-cta-wrapper">
      <a href="/industries/" class="industries-explore-cta">EXPLORE SOLUTIONS</a>
    </div>

    <!-- Section Subheading -->
    <div class="industries-subheading-section">
      <h3 class="industries-subheading">Industry Solutions Built to Scale</h3>
      <p class="industries-subheading-description">Each industry presents unique operational challenges. We engineer tailored AI and automation solutions that fit your workflows.</p>
    </div>

    <!-- Industries Grid -->
    <div class="industries-grid">
      {industries.map((industry) => (
        <article class="industry-card">
          <div class="card-icon">{industry.icon}</div>
          <div class="card-content">
            <h4 class="card-title">{industry.name}</h4>
            <p class="card-headline">{industry.headline}</p>
            <p class="card-description">{industry.description}</p>
          </div>
          <div class="card-footer">
            <a href={industry.route} class="card-link">Explore This Industry →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .industries-section {
    padding: 80px 1.5rem;
    background: linear-gradient(135deg, #f5f9fd 0%, #f9fafb 100%);
  }

  .industries-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .industries-hero-content {
    max-width: 800px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .industries-main-heading {
    margin: 0 0 1.2rem;
    color: #0b1f44;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .industries-description {
    margin: 0;
    color: #62788e;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    line-height: 1.6;
  }

  .industries-cta-wrapper {
    display: flex;
    justify-content: center;
    margin: 32px 0;
  }

  .industries-explore-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 32px;
    background: #2563eb;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.2);
  }

  .industries-explore-cta:hover {
    background: #1d4ed8;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    transform: translateY(-2px);
  }

  .industries-subheading-section {
    max-width: 760px;
    margin: 48px auto 40px;
    text-align: center;
  }

  .industries-subheading {
    margin: 0 0 0.8rem;
    color: #0b1f44;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .industries-subheading-description {
    margin: 0;
    color: #62788e;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .industries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  @media (min-width: 1024px) {
    .industries-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
  }

  .industry-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px;
    background: #ffffff;
    border: 1px solid #dce7f3;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(23, 78, 166, 0.06);
    transition: all 0.3s;
    outline: none;
  }

  .industry-card:hover {
    border-color: rgba(37, 99, 235, 0.3);
    box-shadow: 0 8px 24px rgba(23, 78, 166, 0.1);
    transform: translateY(-4px);
  }

  .industry-card:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 2px;
  }

  .card-icon {
    font-size: 3rem;
    margin-bottom: 16px;
    line-height: 1;
  }

  .card-content {
    flex: 1;
    margin-bottom: 16px;
  }

  .card-title {
    margin: 0 0 8px;
    color: #0b1f44;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .card-headline {
    margin: 0 0 0.75rem;
    color: #0b1f44;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .card-description {
    margin: 0;
    color: #62788e;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .card-footer {
    border-top: 1px solid #e5ecf3;
    padding-top: 16px;
    margin-top: auto;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #2563eb;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }

  .card-link:hover {
    color: #1d4ed8;
  }

  @media (max-width: 768px) {
    .industries-section {
      padding: 60px 1.5rem;
    }

    .industries-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .industry-card {
      padding: 20px;
    }

    .card-icon {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .industries-section {
      padding: 48px 1.5rem;
    }

    .industries-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .industries-main-heading {
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      margin-bottom: 1rem;
    }

    .industries-explore-cta {
      padding: 10px 24px;
      font-size: 0.75rem;
    }
  }
</style>
