---
/**
 * src/components/CaseStudiesHero.astro
 * 
 * Hero section for Case Studies page
 */
---

<section class="case-studies-hero">
  <div class="hero-inner">
    <div class="hero-content">
      <h1 class="hero-title">
        Engineering Intelligent Solutions for Real-World Challenges.
      </h1>
      <p class="hero-subtitle">
        Explore how we apply AI engineering, intelligent automation and custom software development to solve complex business problems and build practical digital solutions.
      </p>
    </div>

    <div class="hero-visual">
      <svg class="hero-svg" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="grad-hero" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#1677FF;stop-opacity:0.8" />
            <stop offset="100%" style="stop-color:#22D3EE;stop-opacity:0.6" />
          </linearGradient>
          <filter id="glow-hero">
            <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
            <feMerge>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>

        <!-- Central orchestrator -->
        <circle cx="200" cy="150" r="35" fill="none" stroke="#1677FF" stroke-width="2.5" opacity="0.9" filter="url(#glow-hero)"/>
        <circle cx="200" cy="150" r="22" fill="none" stroke="#22D3EE" stroke-width="1.5" opacity="0.7"/>
        <circle cx="200" cy="150" r="10" fill="#1677FF" opacity="1"/>

        <!-- Connected nodes -->
        <!-- Top Left -->
        <line x1="200" y1="150" x2="100" y2="80" stroke="url(#grad-hero)" stroke-width="2" opacity="0.6"/>
        <circle cx="100" cy="80" r="12" fill="none" stroke="#22D3EE" stroke-width="2" opacity="0.8"/>
        <circle cx="100" cy="80" r="5" fill="#22D3EE" opacity="1"/>

        <!-- Top Right -->
        <line x1="200" y1="150" x2="300" y2="80" stroke="url(#grad-hero)" stroke-width="2" opacity="0.6"/>
        <circle cx="300" cy="80" r="12" fill="none" stroke="#1677FF" stroke-width="2" opacity="0.8"/>
        <circle cx="300" cy="80" r="5" fill="#1677FF" opacity="1"/>

        <!-- Bottom Left -->
        <line x1="200" y1="150" x2="80" y2="230" stroke="url(#grad-hero)" stroke-width="2" opacity="0.6"/>
        <circle cx="80" cy="230" r="12" fill="none" stroke="#22D3EE" stroke-width="2" opacity="0.8"/>
        <circle cx="80" cy="230" r="5" fill="#22D3EE" opacity="1"/>

        <!-- Bottom Right -->
        <line x1="200" y1="150" x2="320" y2="230" stroke="url(#grad-hero)" stroke-width="2" opacity="0.6"/>
        <circle cx="320" cy="230" r="12" fill="none" stroke="#1677FF" stroke-width="2" opacity="0.8"/>
        <circle cx="320" cy="230" r="5" fill="#1677FF" opacity="1"/>

        <!-- Background nodes (subtle) -->
        <circle cx="200" cy="60" r="8" fill="none" stroke="#1677FF" stroke-width="1" opacity="0.3"/>
        <circle cx="200" cy="240" r="8" fill="none" stroke="#22D3EE" stroke-width="1" opacity="0.3"/>
        <circle cx="50" cy="150" r="6" fill="none" stroke="#22D3EE" stroke-width="1" opacity="0.3"/>
        <circle cx="350" cy="150" r="6" fill="none" stroke="#1677FF" stroke-width="1" opacity="0.3"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .case-studies-hero {
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    background: linear-gradient(135deg, #f5f9fd 0%, #f0f7ff 100%);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.055em;
    color: var(--text-primary);
    margin: 0;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
    max-width: 520px;
  }

  .hero-visual {
    position: relative;
    height: min(450px, 50vh);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-svg {
    width: 100%;
    max-width: 450px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(22, 119, 255, 0.12));
  }

  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-visual {
      height: 350px;
    }

    .hero-title {
      font-size: 2.25rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }
  }

  @media (max-width: 640px) {
    .case-studies-hero {
      padding: 3rem 1rem;
    }

    .hero-inner {
      gap: 2rem;
    }

    .hero-title {
      font-size: 1.75rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
    }

    .hero-visual {
      height: 280px;
    }
  }
</style>

