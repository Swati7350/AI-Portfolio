---
/**
 * src/components/WorkflowDiagram.astro
 * 
 * Static workflow diagram showing connected process steps
 * No animations, responsive layout
 */

interface Props {
  steps: Array<{
    title: string;
    description?: string;
  }>;
  title?: string;
}

const { steps, title = "How It Works" } = Astro.props;
---

<section class="workflow-section" aria-labelledby="workflow-title">
  <div class="workflow-container">
    {title && (
      <header class="workflow-header">
        <h2 id="workflow-title">{title}</h2>
      </header>
    )}

    <div class="workflow-diagram">
      <div class="workflow-steps">
        {steps.map((step, index) => (
          <div class="workflow-step" data-step={index + 1}>
            <div class="step-box">
              <div class="step-number">{index + 1}</div>
              <div class="step-content">
                <h3>{step.title}</h3>
                {step.description && <p>{step.description}</p>}
              </div>
            </div>
            {index < steps.length - 1 && (
              <div class="step-connector" aria-hidden="true">
                <svg viewBox="0 0 40 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                  <line x1="20" y1="0" x2="20" y2="80" stroke="currentColor" stroke-width="2" stroke-dasharray="6,4" />
                  <polygon points="20,75 15,65 25,65" fill="currentColor" />
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .workflow-section {
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
    background: linear-gradient(135deg, #f5f9fd 0%, #f9fafb 100%);
  }

  .workflow-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .workflow-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .workflow-header h2 {
    margin: 0;
    color: #102A43;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .workflow-diagram {
    position: relative;
    width: 100%;
  }

  .workflow-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  @media (min-width: 1024px) {
    .workflow-steps {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      justify-content: space-between;
    }
  }

  .workflow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    position: relative;
    flex: 1;
  }

  @media (min-width: 1024px) {
    .workflow-step {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
    }
  }

  .step-box {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
    max-width: 600px;
    padding: 1.5rem;
    background: #FFFFFF;
    border: 1px solid #E5ECF3;
    border-radius: 10px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  @media (min-width: 1024px) {
    .step-box {
      flex: 1;
      max-width: none;
      gap: 0.75rem;
      padding: 1.25rem;
      min-width: 0;
    }
  }

  @media (max-width: 768px) {
    .step-box {
      gap: 0.75rem;
      padding: 1.25rem;
    }
  }

  .step-box:hover {
    border-color: rgba(34, 211, 238, 0.4);
    box-shadow: 0 4px 12px rgba(34, 211, 238, 0.06);
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: linear-gradient(135deg, #22D3EE 0%, #06B6D4 100%);
    color: #FFFFFF;
    font-size: 1.1rem;
    font-weight: 700;
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .step-number {
      width: 40px;
      height: 40px;
      min-width: 40px;
      font-size: 1rem;
    }
  }

  .step-content {
    flex: 1;
    padding-top: 0;
    min-width: 0;
  }

  .step-content h3 {
    margin: 0 0 0.3rem;
    color: #102A43;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.2;
  }

  @media (min-width: 1024px) {
    .step-content h3 {
      font-size: 0.85rem;
      margin-bottom: 0.2rem;
    }
  }

  .step-content p {
    margin: 0;
    color: #62788e;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  @media (min-width: 1024px) {
    .step-content p {
      font-size: 0.75rem;
    }
  }

  .step-connector {
    width: 40px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #22D3EE;
    margin: 0;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .step-connector {
      width: 32px;
      height: 32px;
      writing-mode: horizontal-tb;
    }
  }

  .step-connector svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (min-width: 1024px) {
    .step-connector svg {
      transform: rotate(90deg);
    }
  }

  @media (max-width: 768px) {
    .step-connector {
      height: 40px;
    }

    .step-box {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .step-box {
      padding: 1rem;
    }

    .step-number {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }

    .step-connector {
      height: 36px;
    }
  }
</style>
