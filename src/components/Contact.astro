---
// Use Formspree endpoint directly - get from environment or use default
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || "https://formspree.io/f/xoevzglj";

// Service-specific default messages
const serviceMessages: Record<string, string> = {
  "AI Applications & Business Automations": "I'm interested in learning more about AI applications and business automation solutions for our organization.",
  "Data Annotation & AI Training": "We need help with data annotation and AI model training. I'd like to discuss our requirements.",
  "Third-Party Integrations": "We're looking to integrate our existing systems. Can you help us with third-party integrations?",
  "Custom Software & SaaS": "I'm interested in custom software development and SaaS solutions tailored to our business needs.",
  "Websites & Digital Marketing": "We need help building a website and implementing digital marketing strategies.",
  "Not sure yet": "I'd like to discuss potential AI and software solutions for our business."
};
---
<section id="contact" class="flat-spacing pt-0">
  <div class="section-contact">
    <div class="contact-image">
      <img src="/wp-content/themes/aigocy/assets/images/section/contact-image-bg.jpg" alt="" loading="lazy" />
    </div>
    <div class="container">
      <div class="row">
        <div class="col-lg-6">
          <div class="col-left">
            <div class="heading-section mb-48">
              <div class="heading-sub fw-semibold effectFade fadeUp">Contact</div>
              <div class="heading-title text-gradient-3 effectFade fadeRotateX">Let's Build<br />Intelligent Things</div>
            </div>
            <div>
              <div class="contact-item mb-20 effectFade fadeRotateX">
                <i class="icon icon-envelope-solid" aria-hidden="true"></i>
                <div class="content">
                  <div class="title fw-semibold mb-2">E-mail address</div>
                  <a class="text" href="mailto:sales@parasaiinnovations.com">sales@parasaiinnovations.com</a>
                </div>
              </div>
              <div class="contact-item effectFade fadeRotateX">
                <i class="icon icon-tty-solid" aria-hidden="true"></i>
                <div class="content">
                  <div class="title fw-semibold mb-2">Phone</div>
                  <a class="text" href="tel:+917350875804">+91-7350875804</a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="form-contact effectFade fadeUp">
            <form id="contact-form" method="POST" action={formspreeEndpoint || ""}>
              <div class="contact-form-fields">
              <h4 class="heading fw-semibold">Fill this form below</h4>
              <fieldset class="mb-21">
                <label class="fw-semibold text-body-3 mb-20" for="contact-name">Full Name <span aria-label="required">*</span></label>
                <input 
                  id="contact-name" 
                  class="form-control" 
                  type="text" 
                  name="name"
                  autocomplete="name" 
                  placeholder="Enter your full name" 
                  required 
                  aria-required="true"
                />
              </fieldset>
              <fieldset class="mb-21">
                <label class="fw-semibold text-body-3 mb-20" for="contact-email">Work Email <span aria-label="required">*</span></label>
                <input 
                  id="contact-email" 
                  class="form-control" 
                  type="email" 
                  name="email"
                  autocomplete="email" 
                  placeholder="Enter your work email" 
                  required 
                  aria-required="true"
                />
              </fieldset>
              <fieldset class="mb-21">
                <label class="fw-semibold text-body-3 mb-20" for="contact-company">Company Name <span aria-label="required">*</span></label>
                <input
                  id="contact-company"
                  class="form-control"
                  type="text"
                  name="company"
                  placeholder="Enter your company name"
                  autocomplete="organization"
                  required
                  aria-required="true"
                />
              </fieldset>
              <fieldset class="mb-21">
                <label class="fw-semibold text-body-3 mb-20" for="contact-service">Service Required <span aria-label="required">*</span></label>
                <select
                  id="contact-service"
                  class="form-control"
                  name="service"
                  required
                  aria-required="true"
                >
                  <option value="" disabled selected>Select a service</option>
                  <option value="AI Applications & Business Automations">AI Applications & Business Automations</option>
                  <option value="Data Annotation & AI Training">Data Annotation & AI Training</option>
                  <option value="Third-Party Integrations">Third-Party Integrations</option>
                  <option value="Custom Software & SaaS">Custom Software & SaaS</option>
                  <option value="Websites & Digital Marketing">Websites & Digital Marketing</option>
                  <option value="Not sure yet">Not sure yet</option>
                </select>
              </fieldset>
              <fieldset class="mb-18">
                <label class="fw-semibold text-body-3 mb-0" for="contact-message">Message / Project Details <span aria-label="required">*</span></label>
                <textarea 
                  id="contact-message" 
                  class="form-control" 
                  name="message" 
                  rows="4" 
                  maxlength="2000" 
                  placeholder="Tell us a little about your project"
                  required
                  aria-required="true"
                  data-service-messages={JSON.stringify(serviceMessages)}
                ></textarea>
              </fieldset>

              <input type="hidden" name="_gotcha" tabindex="-1" autocomplete="off" />
              <button 
                type="submit" 
                class="tf-btn w-100" 
                id="contact-submit-btn"
                disabled={!formspreeEndpoint}
              >
                Submit Message
              </button>
              </div>
              <p 
                class="contact-form-note" 
                id="contact-form-note" 
                role="status"
                aria-live="polite"
              >
                {!formspreeEndpoint && "The enquiry form is temporarily unavailable. Please email sales@parasaiinnovations.com."}
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .section-contact .contact-image::after { content:""; position:absolute; inset:0; border-radius:inherit; background:rgba(9,9,11,.16); pointer-events:none; }
  .section-contact .contact-image { overflow:hidden; }
  .section-contact .contact-item .content .text { color:inherit; text-decoration:none; }
  .section-contact .contact-item .content .text:hover { color:var(--brand); }
  .section-contact .form-contact fieldset { border:0; padding:0; margin-left:0; margin-right:0; min-width:0; }
  .section-contact .form-contact label { display:block; }
  .section-contact .form-contact label span { color: #fd3a25; }
  .section-contact .form-control { width:100%; min-height:50px; padding:13px 16px; border:1px solid #d4d4d8; border-radius:12px; background:#fff; color:#18181b; font:inherit; }
  .section-contact .form-contact textarea.form-control { min-height:114px; resize:vertical; }
  .section-contact .form-control:focus { outline:2px solid rgba(253,58,37,.35); border-color:#fd3a25; }
  .section-contact select.form-control { appearance:auto; cursor:pointer; }
  .section-contact .form-control:invalid:not(:placeholder-shown) { border-color: #ef4444; }
  .section-contact .attachment { flex-wrap:wrap; }
  .section-contact .attachment input { max-width:100%; font-size:13px; }
  .contact-form-note { margin:14px 0 0; color:#71717a; font-size:12px; line-height:1.5; }
  .tf-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .contact-form--loading .tf-btn { opacity: 0.6; pointer-events: none; }
  .contact-form--success {
    padding: 28px 32px;
    min-height: 0;
    background-color: #f0fdf4;
    border-color: #22c55e;
  }
  .contact-form--success .contact-form-fields {
    display: none;
  }
  .contact-form--success .contact-form-note {
    margin: 0;
    color: #166534;
    font-size: 15px;
    line-height: 1.65;
    text-align: center;
  }
  @media (max-width: 767px) {
    .contact-form--success {
      padding: 24px 20px;
    }
  }
  .contact-form--error { background-color: #fef2f2; border-color: #ef4444; }
</style>
<script define:vars={{ formspreeEndpoint }}>
  const contactForm = document.querySelector("#contact-form");
  const submitBtn = document.querySelector("#contact-submit-btn");
  const noteEl = document.querySelector("#contact-form-note");
  const formContainer = contactForm?.closest(".form-contact");
  const messageField = document.querySelector("#contact-message");
  const serviceField = document.querySelector('[name="service"]');

  // Parse service messages from data attribute
  const serviceMessagesJson = messageField?.getAttribute("data-service-messages");
  const serviceMessages = serviceMessagesJson ? JSON.parse(serviceMessagesJson) : {};

  // Update message field when service changes
  if (serviceField && messageField) {
    serviceField.addEventListener("change", () => {
      const selectedService = serviceField.value;
      if (selectedService && serviceMessages[selectedService]) {
        messageField.value = serviceMessages[selectedService];
      }
    });
  }

  if (contactForm) {
    window.dataLayer = window.dataLayer || [];
    let formStartTracked = false;
    contactForm.addEventListener("focusin", () => {
      if (formStartTracked) return;
      formStartTracked = true;
      window.dataLayer.push({ event: "form_start", form_id: "contact-form" });
    });
    const attachmentInput = contactForm.querySelector('[name="attachment"]');
    attachmentInput?.addEventListener("change", () => {
      if (attachmentInput.files?.length) {
        window.dataLayer.push({
          event: "file_upload",
          form_id: "contact-form",
          file_count: attachmentInput.files.length
        });
      }
    });

    const params = new URLSearchParams(window.location.search);
    const trackedKeys = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];

    // Keep campaign attribution while a visitor moves from a service page to the contact form.
    trackedKeys.forEach((key) => {
      const value = params.get(key);
      try {
        if (value) window.sessionStorage.setItem(`paras_${key}`, value);
        const storedValue = value || window.sessionStorage.getItem(`paras_${key}`) || "";
        const field = contactForm.querySelector(`[name="${key}"]`);
        if (field) field.value = storedValue;
      } catch {
        const field = contactForm.querySelector(`[name="${key}"]`);
        if (field) field.value = value || "";
      }
    });

    const landingPageField = contactForm.querySelector('[name="landing_page"]');
    const referrerField = contactForm.querySelector('[name="referrer"]');
    const incomingLandingPage = params.get("landing_page");
    try {
      if (incomingLandingPage) window.sessionStorage.setItem("paras_landing_page", incomingLandingPage);
      const originalLandingPage = incomingLandingPage || window.sessionStorage.getItem("paras_landing_page") || window.location.href;
      if (landingPageField) landingPageField.value = originalLandingPage;
      if (referrerField) referrerField.value = document.referrer || "Direct";
    } catch {
      if (landingPageField) landingPageField.value = incomingLandingPage || window.location.href;
      if (referrerField) referrerField.value = document.referrer || "Direct";
    }

    const requestedService = params.get("service");
    const serviceFieldSelect = contactForm.querySelector('[name="service"]');
    if (requestedService && serviceFieldSelect) {
      const matchingOption = [...serviceFieldSelect.options].find((option) => option.value === requestedService);
      if (matchingOption) {
        serviceFieldSelect.value = requestedService;
        // Trigger change event to populate message
        serviceFieldSelect.dispatchEvent(new Event("change"));
      }
    }
  }

  if (contactForm && formspreeEndpoint) {
    contactForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitBtn.disabled) return;

      noteEl.textContent = "";
      formContainer?.classList.remove("contact-form--error", "contact-form--success");
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = "Sending...";
      formContainer?.classList.add("contact-form--loading");

      try {
        console.log("Form submission started");
        console.log("API endpoint:", formspreeEndpoint);
        
        const formData = new FormData(contactForm);
        
        const response = await fetch(formspreeEndpoint, {
          method: "POST",
          body: formData,
          mode: "no-cors",
        });

        // With no-cors mode, we can't inspect the response, but Formspree will process it
        // Assume success since the request went through without throwing an error
        console.log("Form submission successful!");
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: "generate_lead",
          form_id: "contact-form",
          service: formData.get("service") || "Not specified"
        });

        formContainer?.classList.remove("contact-form--loading");
        formContainer?.classList.add("contact-form--success");
        noteEl.textContent = "Thank you for contacting Paras AI Innovations. Your enquiry has been received. Our team will get back to you shortly.";
        noteEl.setAttribute("role", "alert");
        contactForm.reset();
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      } catch (error) {
        console.error("Form submission error:", error);
        formContainer?.classList.remove("contact-form--loading");
        formContainer?.classList.add("contact-form--error");
        noteEl.textContent = "We couldn't send your enquiry. Please try again or email sales@parasaiinnovations.com.";
        noteEl.setAttribute("role", "alert");
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  }
</script>
