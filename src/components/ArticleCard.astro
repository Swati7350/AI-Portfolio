---
/**
 * src/components/ArticleCard.astro
 * 
 * Individual article card component
 */

import type { Article } from '../data/articles';

interface Props {
  article: Article;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
---

<article 
  class={`article-card ${featured ? 'featured' : ''}`}
  data-article-id={article.id}
  data-category={article.category}
>
  <div class="card-image">
    <img 
      src={article.featuredImage} 
      alt={article.imageAlt}
      width="400"
      height="240"
    />
  </div>

  <div class="card-content">
    <div class="card-meta">
      <span class="card-category">{article.category}</span>
      <span class="card-date">{new Date(article.publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
      <span class="card-reading-time">{article.readingTime} min read</span>
    </div>

    <h3 class="card-title">{article.title}</h3>
    <p class="card-excerpt">{article.excerpt}</p>

    <div class="card-footer">
      <a href={`/insights/${article.slug}/`} class="card-link">
        Read Article →
      </a>
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    opacity: 1;
  }

  .article-card.featured {
    grid-column: span 1;
    border-color: rgba(22, 119, 255, 0.2);
    box-shadow: 0 8px 32px rgba(22, 119, 255, 0.1);
  }

  @media (hover: hover) {
    .article-card:hover {
      border-color: rgba(22, 119, 255, 0.3);
      box-shadow: 0 12px 48px rgba(22, 119, 255, 0.12);
      transform: translateY(-4px);
    }

    .article-card.featured:hover {
      border-color: rgba(22, 119, 255, 0.4);
      box-shadow: 0 16px 56px rgba(22, 119, 255, 0.15);
      transform: translateY(-6px);
    }
  }

  .card-image {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-secondary);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--border);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  @media (hover: hover) {
    .article-card:hover .card-image img {
      transform: scale(1.04);
    }
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .card-category {
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .card-date,
  .card-reading-time {
    font-weight: 500;
  }

  .card-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .article-card.featured .card-title {
    font-size: 1.4rem;
  }

  .card-excerpt {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    margin-top: 0.5rem;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--blue);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  @media (hover: hover) {
    .card-link:hover {
      color: var(--blue-hover);
      transform: translateX(2px);
    }
  }

  .card-link:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .card-content {
      padding: 1.5rem;
      gap: 0.85rem;
    }

    .card-title {
      font-size: 1.1rem;
    }

    .article-card.featured .card-title {
      font-size: 1.2rem;
    }

    .card-excerpt {
      font-size: 0.9rem;
    }

    .card-meta {
      gap: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .card-content {
      padding: 1.25rem;
      gap: 0.75rem;
    }

    .card-title {
      font-size: 1rem;
    }

    .article-card.featured .card-title {
      font-size: 1.1rem;
    }

    .card-excerpt {
      font-size: 0.85rem;
    }

    .card-meta {
      font-size: 0.75rem;
      gap: 0.5rem;
    }

    .card-footer {
      padding-top: 0.75rem;
      margin-top: 0.25rem;
    }

    .card-link {
      font-size: 0.85rem;
    }
  }
</style>
