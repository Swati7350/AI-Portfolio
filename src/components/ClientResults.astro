---
/**
 * Client Results — homepage portfolio section.
 * Added as an independent section; existing homepage sections remain untouched.
 */
const projects = [
  {
    number: '01',
    label: 'Legal AI',
    title: 'Legal AI',
    description: 'Search legal contracts, retrieve relevant clauses, and identify key terms and obligations using AI-powered document intelligence.',
    technologies: ['Claude', 'Pinecone', 'LangChain'],
    image: '/assets/legal Contract Intelligence.png',
    alt: 'Legal AI contract intelligence',
  },
  {
    number: '02',
    label: 'AI Voice Agent',
    title: 'Real Estate AI Voice Agent',
    description: 'An AI-powered voice agent that handles property enquiries, answers property-related questions, and helps schedule site visits.',
    technologies: ['Retell', 'Vapi', 'Bland'],
    image: '/assets/AI Voice Agent.png',
    alt: 'AI voice agent handling real estate enquiries',
  },
  {
    number: '03',
    label: 'Supply Chains AI Agent',
    title: 'Supply Chains AI Agent',
    description: 'Automate three-way matching across purchase orders, goods receipt notes, and supplier invoices. Detect discrepancies and duplicate invoices before payment approval.',
    technologies: ['Python', 'FastAPI', 'OCR', 'SQL'],
    image: '/assets/supply chains Invoice 3wm.png',
    alt: 'AI-powered three-way matching for supply chain and logistics',
  },
  {
    number: '04',
    label: 'Manufacturing Automation',
    title: 'Manufacturing Business Automation',
    description: 'Automate customer enquiries, quotation workflows, order updates, task assignments, and payment follow-ups. Connect business tools to reduce manual work.',
    technologies: ['Workflow Automation', 'CRM Integration', 'Make.com · n8n'],
    image: '/assets/manufacturing automation.png',
    alt: 'Manufacturing business process automation',
  },
  {
    number: '05',
    label: 'Travel Website',
    title: 'Travel Website Development',
    description: 'Build engaging travel websites with destination guides, personalized itineraries, trip planning features, and booking integrations to help travelers discover and plan their journeys.',
    technologies: ['Website Development', 'API Integration', 'AI Travel Assistant'],
    image: '/assets/Travel Website.png',
    alt: 'Travel planning website with destination and trip planning features',
  },
  {
    number: '06',
    label: 'Personalized AI Agent',
    title: 'Personalized AI Agent',
    description: 'Configure AI agents around your business with tailored instructions, company knowledge, model settings and connected business tools.',
    technologies: ['LLM Integration', 'API Integration'],
    image: '/assets/custom ai agent.png',
    alt: 'Personalized AI agent configuration and business tool integrations',
  },
];
---

<section class="client-results-section" id="client-results" aria-labelledby="client-results-title">
  <div class="client-results-inner">
    <header class="client-results-header">
      <span class="client-results-eyebrow">CLIENT RESULTS</span>
      <h2 id="client-results-title">Shipped. Scaled. Sustained.</h2>
      <p>Production-grade engineering outcomes delivered across healthcare, fintech, SaaS, eCommerce, AI, and logistics.</p>
      <a href="/work/" class="client-results-cta">Explore Case Studies <span aria-hidden="true">→</span></a>
    </header>

    <div class="client-results-container" data-client-results role="group" aria-label="Featured project case studies">
      {projects.map((project) => (
        <article
          class:list={['result-card', project.number === '03' && 'result-card--expanded']}
          data-result-card
          tabindex="0"
          role="button"
          aria-expanded={project.number === '03' ? 'true' : 'false'}
          aria-label={`Show project ${project.number}: ${project.title}`}
        >
          <img
            class="result-card__image"
            src={project.image}
            alt={project.alt}
            loading="lazy"
            decoding="async"
          />
          <div class="result-card__scrim" aria-hidden="true"></div>
          <span class="result-card__number">{project.number}</span>
          <span class="result-card__label">{project.label}</span>
          <div class="result-card__content">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="result-card__technologies" aria-label="Technology stack">
              {project.technologies.map((technology) => <span>{technology}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .client-results-section {
    --cr-blue: var(--blue, #2563eb);
    --cr-ink: var(--text, #102a43);
    --cr-muted: var(--text-muted, #647b91);
    --cr-border: var(--border, #e3eaf2);
    width: 100%;
    padding: clamp(64px, 7vw, 92px) 0;
    background: var(--bg, #fff);
    border-top: 1px solid var(--cr-border);
  }

  .client-results-inner {
    width: min(100% - 48px, 1450px);
    margin-inline: auto;
  }

  .client-results-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0 auto 56px;
    max-width: 700px;
  }

  .client-results-eyebrow {
    color: var(--cr-blue);
    font-size: .72rem;
    line-height: 1.4;
    font-weight: 800;
    letter-spacing: .14em;
    margin-bottom: 12px;
  }

  .client-results-header h2 {
    color: var(--cr-ink);
    font-family: var(--font-display, inherit);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -.035em;
    margin: 0 0 16px;
  }

  .client-results-header p {
    max-width: 570px;
    color: var(--cr-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 22px;
  }

  .client-results-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 24px;
    color: var(--cr-blue);
    border: 1.5px solid var(--cr-blue);
    border-radius: 9px;
    background: transparent;
    font-size: .9rem;
    font-weight: 650;
    text-decoration: none;
    transition: color .2s ease, background .2s ease, transform .2s ease;
  }

  .client-results-cta:hover {
    color: #fff;
    background: var(--cr-blue);
    transform: translateY(-2px);
  }

  .client-results-container {
    display: flex;
    align-items: stretch;
    gap: 16px;
    width: 100%;
    height: 500px;
    perspective: 1100px;
  }

  .result-card {
    position: relative;
    isolation: isolate;
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--cr-border);
    border-radius: 14px;
    background: #dce5ed;
    box-shadow: 0 2px 6px rgba(16, 42, 67, .045);
    cursor: pointer;
    outline: none;
    transition: flex .48s cubic-bezier(.2, .7, .2, 1), box-shadow .25s ease, border-color .25s ease;
  }

  .result-card:hover {
    box-shadow: 0 10px 28px rgba(16, 42, 67, .13);
  }

  .result-card:focus-visible {
    outline: 3px solid var(--cr-blue);
    outline-offset: 3px;
  }

  .result-card--expanded {
    flex: 2.5 1 0;
    border-color: rgba(37, 99, 235, .2);
    box-shadow: 0 12px 32px rgba(16, 42, 67, .13);
  }

  .result-card__image,
  .result-card__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .result-card__image {
    z-index: -2;
    object-fit: cover;
    object-position: center;
    transform: scale(1.035);
    filter: blur(3px) brightness(.7);
    transition: filter .4s ease, transform .55s ease;
  }

  .result-card__scrim {
    z-index: -1;
    background: linear-gradient(180deg, rgba(5, 18, 35, .12) 0%, rgba(5, 18, 35, .18) 42%, rgba(5, 18, 35, .78) 100%);
    opacity: .45;
    transition: opacity .35s ease;
  }

  .result-card--expanded .result-card__image {
    filter: none;
    transform: scale(1);
  }

  .result-card--expanded .result-card__scrim {
    opacity: 1;
    background: linear-gradient(180deg, rgba(5, 18, 35, .02) 0%, rgba(5, 18, 35, .18) 36%, rgba(5, 18, 35, .86) 100%);
  }

  .result-card__number {
    position: absolute;
    top: 22px;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%);
    color: #fff;
    font-size: 1.35rem;
    font-weight: 750;
    text-shadow: 0 2px 12px rgba(0, 0, 0, .28);
    pointer-events: none;
  }

  .result-card__label {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    transform: translate(-50%, -50%) rotate(180deg);
    writing-mode: vertical-rl;
    color: #fff;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .19em;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 2px 12px rgba(0, 0, 0, .5);
    transition: opacity .2s ease;
    pointer-events: none;
  }

  .result-card--expanded .result-card__label {
    opacity: 0;
  }

  .result-card__content {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 30px 24px 26px;
    color: #fff;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .28s ease, transform .35s ease;
    pointer-events: none;
  }

  .result-card--expanded .result-card__content {
    opacity: 1;
    transform: translateY(0);
  }

  .result-card__content h3 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display, inherit);
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .result-card__content p {
    margin: 0;
    color: rgba(255, 255, 255, .88);
    font-size: .91rem;
    line-height: 1.58;
  }

  .result-card__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 2px;
  }

  .result-card__technologies span {
    display: inline-flex;
    align-items: center;
    min-height: 25px;
    padding: 3px 9px;
    border: 1px solid rgba(255, 255, 255, .24);
    border-radius: 5px;
    background: rgba(255, 255, 255, .13);
    color: rgba(255, 255, 255, .92);
    font-size: .72rem;
    font-weight: 550;
  }

  @media (max-width: 1050px) {
    .client-results-container {
      height: 430px;
      gap: 11px;
    }

    .result-card--expanded {
      flex: 2.7 1 0;
    }

    .result-card__content {
      padding: 24px 18px 20px;
    }

    .result-card__content p {
      font-size: .84rem;
    }
  }

  @media (max-width: 700px) {
    .client-results-section {
      padding: 58px 0;
    }

    .client-results-inner {
      width: min(100% - 36px, 560px);
    }

    .client-results-header {
      margin-bottom: 32px;
    }

    .client-results-header p {
      font-size: .92rem;
    }

    .client-results-container {
      display: flex;
      flex-direction: column;
      height: auto;
      max-height: none;
      gap: 12px;
      perspective: none;
    }

    .result-card,
    .result-card--expanded {
      flex: none;
      width: 100%;
      height: 92px;
      min-height: 92px;
      border-radius: 12px;
      transition: height .35s ease, box-shadow .25s ease;
    }

    .result-card--expanded {
      height: 340px;
    }

    .result-card__number {
      top: 17px;
      left: 18px;
      transform: none;
      font-size: 1rem;
    }

    .result-card__label {
      top: 50%;
      left: auto;
      right: 18px;
      transform: translateY(-50%);
      writing-mode: horizontal-tb;
      font-size: .65rem;
      letter-spacing: .12em;
    }

    .result-card--expanded .result-card__label {
      opacity: 0;
    }

    .result-card__content {
      padding: 24px 18px 18px;
      gap: 10px;
    }

    .result-card__content h3 {
      font-size: 1.05rem;
    }

    .result-card__content p {
      font-size: .84rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .result-card,
    .result-card__image,
    .result-card__scrim,
    .result-card__label,
    .result-card__content,
    .client-results-cta {
      transition: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-client-results]').forEach((container) => {
    const cards = Array.from(container.querySelectorAll('[data-result-card]'));
    const defaultCard = cards.find((card) => card.querySelector('.result-card__number')?.textContent.trim() === '03') || cards[0];

    const activate = (selected) => {
      cards.forEach((card) => {
        const expanded = card === selected;
        card.classList.toggle('result-card--expanded', expanded);
        card.setAttribute('aria-expanded', String(expanded));
      });
    };

    // Desktop/tablet: expand the card under the pointer, matching the live website.
    container.addEventListener('pointerover', (event) => {
      if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
      const card = event.target.closest('[data-result-card]');
      if (card && container.contains(card)) activate(card);
    });

    // Restore card 03 when the pointer leaves the complete section.
    container.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse' || event.pointerType === 'pen') activate(defaultCard);
    });

    // Touch devices: tap to expand because hover is unavailable.
    cards.forEach((card) => {
      card.addEventListener('click', () => activate(card));
      card.addEventListener('focus', () => activate(card));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate(card);
        }
      });
    });
  });
</script>
