---
const currentYear = new Date().getFullYear();

const exploreLinks = [
  { label: "Home", href: "/" },
  { label: "About Us", href: "/#about" },
  { label: "Services", href: "/#services" },
  { label: "Projects", href: "/projects/" },
  { label: "Contact", href: "/contact/" },
];
---
<footer class="site-footer" id="site-footer">
  <div class="footer-glow footer-glow-top" aria-hidden="true"></div>
  <div class="footer-shell">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-logo" href="/" aria-label="Paras AI Innovations home">
          <img
            src="/images/brand/paras-ai-logo-dark.png"
            alt="Paras AI Innovations"
            width="370"
            height="86"
            loading="lazy"
            decoding="async"
          />
        </a>
        <span class="footer-brand-rule" aria-hidden="true"></span>
        <h2>Understand the Problem.<br />Engineer the Solution.</h2>
        <p>We build practical solutions that simplify operations, connect existing tools and address real business needs.</p>
      </div>

      <nav class="footer-column footer-explore" aria-label="Explore">
        <h3>Explore</h3>
        <ul>
          {exploreLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer-column footer-connect">
        <h3>Connect</h3>
        <ul>
          <li>
            <a href="mailto:sales@parasaiinnovations.com">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4 7 8 6 8-6"></path></svg>
              <span>sales@parasaiinnovations.com</span>
            </a>
          </li>
          <li>
            <a href="tel:+917350875804">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span>+91-7350875804</span>
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/company/paras-ai-innovations/" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9v9M6 6.5v.1M10 18v-5.2a3 3 0 0 1 6 0V18M10 9v9"></path><rect x="2.5" y="2.5" width="19" height="19" rx="2.5"></rect></svg>
              <span>LinkedIn <b aria-hidden="true">↗</b></span>
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-column footer-build">
        <h3>Ready to Build Smarter Systems for Your Business?</h3>
        <p>Let's discuss how intelligent automation can streamline your workflows and drive growth.</p>
        <a class="footer-cta" href="/contact/">
          Discuss Your Project <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {currentYear} Paras AI Innovations. All rights reserved.</p>
      <a class="footer-back-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>

  <svg class="footer-wave" viewBox="0 0 1600 190" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="footerWaveGradient" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ff432b" stop-opacity="0.05" />
        <stop offset="0.55" stop-color="#ff432b" stop-opacity="0.85" />
        <stop offset="1" stop-color="#ff432b" stop-opacity="0.2" />
      </linearGradient>
    </defs>
    <g fill="none" stroke="url(#footerWaveGradient)" stroke-width="1.1">
      <path d="M-30 152 C230 10 410 18 640 92 S1060 185 1270 105 1510 38 1640 8" />
      <path d="M-30 162 C230 20 410 28 640 102 S1060 195 1270 115 1510 48 1640 18" />
      <path d="M-30 172 C230 30 410 38 640 112 S1060 205 1270 125 1510 58 1640 28" />
      <path d="M-30 182 C230 40 410 48 640 122 S1060 215 1270 135 1510 68 1640 38" />
    </g>
  </svg>
</footer>

<style is="global">
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 0 34px;
    background: #171719;
    color: #f8f6f4;
  }

  .footer-shell {
    position: relative;
    z-index: 2;
    width: min(100%, 1480px);
    margin: 0 auto;
  }

  .footer-glow {
    position: absolute;
    z-index: 0;
    width: 520px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(255, 67, 43, .16), transparent 68%);
    filter: blur(24px);
    pointer-events: none;
  }

  .footer-glow-top {
    top: -210px;
    right: -100px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(280px, 1.2fr) minmax(130px, .55fr) minmax(280px, 1.05fr) minmax(300px, 1.2fr);
    gap: clamp(28px, 3.4vw, 58px);
    padding: 76px 0 72px;
  }

  .footer-brand,
  .footer-column {
    min-width: 0;
  }

  .footer-brand {
    padding-right: clamp(20px, 2.8vw, 44px);
  }

  .footer-logo {
    display: inline-flex;
    width: min(100%, 290px);
    align-items: center;
  }

  .footer-logo img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .footer-brand-rule {
    display: block;
    width: 96px;
    height: 4px;
    margin: 25px 0 24px;
    border-radius: 99px;
    background: #ff432b;
  }

  .footer-brand h2 {
    margin: 0;
    color: #f8f6f4;
    font-size: clamp(21px, 1.65vw, 27px);
    font-weight: 720;
    line-height: 1.28;
    letter-spacing: -.035em;
  }

  .footer-brand p,
  .footer-build p {
    margin: 20px 0 0;
    color: #a6a6ac;
    font-size: 15px;
    line-height: 1.65;
  }

  .footer-brand p {
    max-width: 410px;
  }

  .footer-column {
    padding-left: clamp(22px, 3vw, 48px);
    border-left: 1px solid rgba(255,255,255,.18);
  }

  .footer-column h3 {
    margin: 0 0 30px;
    color: #f8f6f4;
    font-size: clamp(19px, 1.55vw, 25px);
    font-weight: 720;
    line-height: 1.25;
    letter-spacing: -.025em;
  }

  .footer-column ul {
    display: grid;
    gap: 17px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column li {
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .footer-column a {
    color: #a6a6ac;
    font-size: 15px;
    line-height: 1.5;
    text-decoration: none;
    transition: color .2s ease, transform .2s ease;
  }

  .footer-explore a {
    display: inline-flex;
  }

  .footer-column a:hover,
  .footer-back-top:hover {
    color: #ff705d;
  }

  .footer-explore a:hover {
    transform: translateX(4px);
  }

  .footer-connect ul {
    gap: 24px;
  }

  .footer-connect a {
    display: flex;
    align-items: center;
    gap: 17px;
    overflow-wrap: anywhere;
  }

  .footer-connect svg {
    flex: 0 0 23px;
    width: 23px;
    height: 23px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .footer-connect b {
    margin-left: 5px;
    color: #ff6048;
    font-size: 18px;
    font-weight: 600;
  }

  .footer-build h3 {
    max-width: 390px;
    margin-bottom: 0;
    font-size: clamp(22px, 1.8vw, 29px);
  }

  .footer-build p {
    max-width: 420px;
    margin-top: 22px;
  }

  .footer-cta {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    gap: 13px;
    margin-top: 28px;
    padding: 0 28px;
    border: 1px solid #ff432b;
    border-radius: 999px;
    background: #ff432b;
    box-shadow: 0 8px 24px rgba(255,67,43,.17);
    color: #fff !important;
    font-size: 15px;
    font-weight: 700;
    transition: background .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .footer-cta:hover {
    background: #e93620;
    box-shadow: 0 12px 28px rgba(255,67,43,.24);
    transform: translateY(-2px);
  }

  .footer-cta span {
    font-size: 19px;
    line-height: 1;
  }

  .footer-bottom {
    display: flex;
    min-height: 78px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid rgba(255,255,255,.24);
  }

  .footer-bottom p {
    margin: 0;
    color: #a6a6ac;
    font-size: 13px;
    line-height: 1.5;
  }

  .footer-back-top {
    color: #a6a6ac;
    font-size: 13px;
    text-decoration: none;
    transition: color .2s ease;
  }

  .footer-back-top span {
    margin-left: 6px;
    color: #ff6048;
    font-size: 17px;
  }

  .footer-wave {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: -18px;
    width: 56%;
    height: 160px;
    opacity: .72;
    pointer-events: none;
  }

  @media (max-width: 1199px) {
    .footer-main {
      grid-template-columns: minmax(250px, 1fr) minmax(130px, .6fr) minmax(250px, 1fr);
      gap: 42px 28px;
    }

    .footer-brand {
      grid-row: span 2;
    }

    .footer-build {
      grid-column: 2 / -1;
    }

    .footer-build h3 {
      max-width: 560px;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      padding: 0 24px;
    }

    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 38px 22px;
      padding: 52px 0 42px;
    }

    .footer-brand,
    .footer-build {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .footer-brand {
      padding-right: 0;
    }

    .footer-logo {
      width: min(100%, 250px);
    }

    .footer-brand-rule {
      margin: 20px 0;
    }

    .footer-brand h2 {
      font-size: 22px;
    }

    .footer-brand p,
    .footer-build p {
      margin-top: 14px;
      font-size: 14px;
    }

    .footer-column {
      padding-left: 0;
      border-left: 0;
    }

    .footer-column h3 {
      margin-bottom: 19px;
      font-size: 18px;
    }

    .footer-column ul {
      gap: 13px;
    }

    .footer-column a {
      font-size: 13px;
    }

    .footer-connect {
      grid-column: 1 / -1;
    }

    .footer-connect ul {
      gap: 17px;
    }

    .footer-build h3 {
      max-width: 430px;
      font-size: 24px;
    }

    .footer-cta {
      min-height: 50px;
      margin-top: 22px;
      padding: 0 22px;
      font-size: 14px;
    }

    .footer-bottom {
      min-height: 68px;
    }

    .footer-wave {
      width: 100%;
      height: 110px;
      opacity: .38;
    }
  }

  @media (max-width: 380px) {
    .site-footer {
      padding-inline: 18px;
    }

    .footer-main {
      gap: 32px 16px;
    }

    .footer-connect a {
      gap: 11px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-column a,
    .footer-cta,
    .footer-back-top {
      transition: none !important;
    }
  }

  /* Isolated footer theme overrides: prevent the site's global light-footer rules from winning. */
  #site-footer.site-footer {
    background: #171719 !important;
    color: #f8f6f4 !important;
    color-scheme: dark;
  }
  #site-footer.site-footer .footer-shell { position: relative; z-index: 2; }
  #site-footer.site-footer .footer-brand h2,
  #site-footer.site-footer .footer-column h3 {
    color: #f8f6f4 !important;
  }
  #site-footer.site-footer .footer-brand p,
  #site-footer.site-footer .footer-build p,
  #site-footer.site-footer .footer-column a,
  #site-footer.site-footer .footer-bottom p,
  #site-footer.site-footer .footer-back-top {
    color: #a6a6ac !important;
  }
  #site-footer.site-footer .footer-column a:hover,
  #site-footer.site-footer .footer-back-top:hover {
    color: #ff705d !important;
  }
  #site-footer.site-footer .footer-cta {
    background: #ff432b !important;
    border-color: #ff432b !important;
    color: #fff !important;
  }
  #site-footer.site-footer .footer-bottom {
    border-top-color: rgba(255,255,255,.24) !important;
  }
  #site-footer.site-footer .footer-brand-rule { background: #ff432b !important; }
  #site-footer.site-footer .footer-wave { pointer-events: none; }

</style>
