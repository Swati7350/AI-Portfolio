---
/**
 * src/components/ProcessSection.astro
 * 
 * Displays the 4-step "How We Work" process
 */

const steps = [
  {
    number: "01",
    title: "Discovery",
    description: "We listen to understand your specific workflows, pain points, and goals.",
  },
  {
    number: "02",
    title: "Design & Planning",
    description: "We plan the solution architecture and integration points with your existing systems.",
  },
  {
    number: "03",
    title: "Build & Integration",
    description: "We develop and integrate your custom AI solution into your workflows.",
  },
  {
    number: "04",
    title: "Launch & Support",
    description: "We deploy, train your team, and provide ongoing support.",
  },
];
---

<style>
  .process-section {
    padding: 6rem 1rem;
    background: var(--bg);
  }

  .section-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .process-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
  }

  .process-card {
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-secondary);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: border-color 0.2s, background-color 0.2s, transform 0.2s;
    position: relative;
  }

  .process-card:hover {
    border-color: var(--blue);
    background: rgba(22, 119, 255, 0.02);
    transform: translateY(-4px);
  }

  .process-card-header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .process-card-num {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--blue);
    flex-shrink: 0;
  }

  .process-card-icon {
    color: var(--blue);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .process-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .process-card-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  @media (max-width: 768px) {
    .process-section {
      padding: 4rem 1rem;
    }

    .process-cards {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .section-title {
      font-size: 1.75rem;
    }
  }
</style>