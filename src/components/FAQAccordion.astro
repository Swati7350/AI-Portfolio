---
/**
 * src/components/FAQAccordion.astro
 * 
 * Accessible FAQ accordion component with keyboard navigation
 */

interface Props {
  faqs: Array<{
    question: string;
    answer: string;
  }>;
  title?: string;
  description?: string;
}

const { faqs, title = "Frequently Asked Questions", description } = Astro.props;
---

<section class="faq-section" aria-labelledby="faq-title">
  <div class="faq-container">
    {title && (
      <header class="faq-header">
        <h2 id="faq-title">{title}</h2>
        {description && <p>{description}</p>}
      </header>
    )}

    <div class="faq-list" role="region" aria-label="Frequently asked questions">
      {faqs.map((faq, index) => (
        <details class="faq-item" data-index={index}>
          <summary class="faq-question">{faq.question}</summary>
          <div class="faq-answer">{faq.answer}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // Enhance accordion with keyboard navigation
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll<HTMLDetailsElement>('.faq-item');

    items.forEach((item, index) => {
      const summary = item.querySelector<HTMLElement>('.faq-question');
      if (!summary) return;

      summary.addEventListener('click', (e) => {
        // Close other open items when opening a new one
        items.forEach((otherItem, otherIndex) => {
          if (otherIndex !== index && otherItem.open) {
            otherItem.open = false;
          }
        });
      });

      // Keyboard navigation
      summary.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (index < items.length - 1) {
            items[index + 1].querySelector<HTMLElement>('.faq-question')?.focus();
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (index > 0) {
            items[index - 1].querySelector<HTMLElement>('.faq-question')?.focus();
          }
        } else if (e.key === 'Home') {
          e.preventDefault();
          items[0].querySelector<HTMLElement>('.faq-question')?.focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          items[items.length - 1].querySelector<HTMLElement>('.faq-question')?.focus();
        }
      });
    });
  });
</script>

<style>
  .faq-section {
    padding: 56px 1.5rem;
    background: #FFFFFF;
  }

  .faq-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .faq-header {
    margin-bottom: 32px;
    text-align: center;
  }

  .faq-header h2 {
    margin: 0 0 0.8rem;
    color: #102A43;
    font-size: clamp(1.6rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .faq-header p {
    margin: 0;
    color: #62788e;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    padding: 0;
    background: #FFFFFF;
    border: 1px solid #E5ECF3;
    border-radius: 10px;
    overflow: hidden;
  }

  .faq-item:hover {
    border-color: rgba(34, 211, 238, 0.3);
    box-shadow: 0 2px 8px rgba(23, 78, 166, 0.04);
  }

  .faq-item[open] {
    border-color: rgba(34, 211, 238, 0.4);
    box-shadow: 0 2px 8px rgba(34, 211, 238, 0.06);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: #FFFFFF;
    color: #102A43;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question:hover {
    background: rgba(34, 211, 238, 0.03);
    color: #0B1F44;
  }

  .faq-question:focus {
    outline: 2px solid #2563EB;
    outline-offset: -2px;
  }

  .faq-question::after {
    content: '▼';
    font-size: 0.7rem;
    line-height: 1;
    color: #22D3EE;
    margin-left: auto;
    margin-right: 0;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-question::after {
    content: '▲';
  }

  .faq-answer {
    padding: 0 1.25rem 1rem;
    color: #62788e;
    font-size: 0.9rem;
    line-height: 1.6;
    background: rgba(245, 249, 253, 0.5);
  }

  @media (max-width: 768px) {
    .faq-section {
      padding: 48px 1.5rem;
    }

    .faq-header {
      margin-bottom: 24px;
    }

    .faq-header h2 {
      font-size: clamp(1.4rem, 3vw, 1.8rem);
      margin-bottom: 0.6rem;
    }

    .faq-question {
      padding: 0.9rem 1rem;
      font-size: 0.9rem;
    }

    .faq-answer {
      padding: 0 1rem 0.9rem;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .faq-list {
      gap: 10px;
    }

    .faq-question {
      padding: 0.8rem 0.9rem;
      font-size: 0.85rem;
    }

    .faq-answer {
      padding: 0 0.9rem 0.8rem;
      font-size: 0.8rem;
    }
  }
</style>
