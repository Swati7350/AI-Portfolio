---
/**
 * src/components/CaseStudyCard.astro
 * 
 * Individual case study card component
 */

import type { CaseStudy } from '../data/caseStudies';

interface Props {
  study: CaseStudy & { displayCategory?: string };
  featured?: boolean;
}

const { study, featured = false } = Astro.props;
const category = study.displayCategory || study.category.split('|')[0].trim();
---

<article class={`case-study-card ${featured ? 'featured' : ''}`} data-study-category={category}>
  <div class="card-header">
    <span class="card-category">{category}</span>
  </div>

  <h3 class="card-title">{study.title}</h3>

  <p class="card-description">{study.shortDescription}</p>

  <a href={`/case-studies/${study.id}/`} class="card-cta">
    Explore Case Study →
  </a>
</article>

<style>
  .case-study-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .case-study-card.featured {
    grid-column: span 1;
    padding: 2.5rem;
    border-color: rgba(22, 119, 255, 0.2);
    background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
    box-shadow: 0 8px 32px rgba(22, 119, 255, 0.1);
  }

  @media (hover: hover) {
    .case-study-card:hover {
      border-color: rgba(22, 119, 255, 0.3);
      box-shadow: 0 12px 48px rgba(22, 119, 255, 0.12);
      transform: translateY(-4px);
    }

    .case-study-card.featured:hover {
      border-color: rgba(22, 119, 255, 0.4);
      box-shadow: 0 16px 56px rgba(22, 119, 255, 0.15);
      transform: translateY(-6px);
    }
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .card-category {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .card-title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }

  .case-study-card.featured .card-title {
    font-size: 1.55rem;
  }

  .card-description {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    flex: 1;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    color: var(--blue);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  @media (hover: hover) {
    .card-cta:hover {
      color: var(--blue-hover);
      transform: translateX(2px);
    }

    .card-cta:hover::after {
      transform: translateX(3px);
    }
  }

  .card-cta::after {
    content: '';
    transition: transform 0.25s ease;
  }

  @media (max-width: 768px) {
    .case-study-card {
      padding: 1.75rem;
      gap: 0.85rem;
    }

    .case-study-card.featured {
      padding: 2rem;
    }

    .card-title {
      font-size: 1.25rem;
    }

    .case-study-card.featured .card-title {
      font-size: 1.35rem;
    }

    .card-description {
      font-size: 0.9rem;
    }
  }
</style>
