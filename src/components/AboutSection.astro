---
/**
 * src/components/AboutSection.astro
 * 
 * About/Why We're Different section with team showcase
 * Displays the company's value proposition
 */
---

<style>
  .about-section {
    padding: 6rem 1rem;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .section-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .about-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .about-card {
    padding: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-secondary);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: border-color 0.2s, background-color 0.2s, transform 0.2s;
    text-align: center;
  }

  .about-card:hover {
    border-color: var(--blue);
    background: rgba(22, 119, 255, 0.02);
    transform: translateY(-4px);
  }

  .about-card-icon {
    display: flex;
    justify-content: center;
    color: var(--blue);
  }

  .about-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .about-card-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .about-section {
      padding: 4rem 1rem;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .section-title {
      font-size: 1.75rem;
    }

    .about-card {
      padding: 2rem;
    }
  }
</style>
