---
/**
 * src/components/CaseStudiesCTA.astro
 * 
 * Final call-to-action section for Case Studies page
 */
---

<section class="case-studies-cta">
  <div class="cta-inner">
    <div class="cta-content">
      <h2 class="cta-title">Have a Complex Challenge to Solve?</h2>
      <p class="cta-description">
        Let's explore how intelligent systems and custom software can help your business move forward.
      </p>
      <a href="/contact/" class="cta-button">Discuss Your Project →</a>
    </div>
  </div>
</section>

<style>
  .case-studies-cta {
    padding: clamp(4rem, 8vw, 6.5rem) 1.5rem;
    background: linear-gradient(135deg, #0B1F44 0%, #102A43 58%, #0D2555 100%);
    color: #FFFFFF;
  }

  .cta-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .cta-content {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cta-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: #FFFFFF;
    margin: 0;
  }

  .cta-description {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: clamp(0.85rem, 1.5vw, 1.05rem) clamp(1.5rem, 3vw, 2.25rem);
    background: linear-gradient(135deg, #1677FF 0%, #0D5FD4 100%);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 24px rgba(22, 119, 255, 0.3);
    transition: all 0.3s ease;
    margin-top: 0.5rem;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  @media (hover: hover) {
    .cta-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(22, 119, 255, 0.4);
    }

    .cta-button:active {
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .case-studies-cta {
      padding: 3rem 1rem;
    }

    .cta-title {
      font-size: 1.75rem;
    }

    .cta-description {
      font-size: 1rem;
    }

    .cta-button {
      padding: 0.85rem 1.75rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .cta-content {
      gap: 1.25rem;
    }

    .cta-title {
      font-size: 1.45rem;
    }

    .cta-description {
      font-size: 0.95rem;
    }

    .cta-button {
      width: 100%;
    }
  }
</style>

