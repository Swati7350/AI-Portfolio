---
/**
 * src/components/IndustriesLanding.astro
 * 
 * Industries landing page component with:
 * - Hero section
 * - Industry intro
 * - 6-card industry grid
 * - Cross-industry capabilities
 * - 4-step approach section
 * - CTA section
 */

import { industries } from '../data/industries';
---

<!-- Hero Section -->
<section class="industries-hero" aria-labelledby="industries-hero-title">
  <div class="industries-hero-inner">
    <div class="industries-hero-content">
      <h1 id="industries-hero-title">AI & Automation Across Every Industry</h1>
      <p>Discover how Paras AI Innovations applies intelligent automation, AI agents, and connected systems to solve real operational challenges across diverse business sectors.</p>
    </div>
  </div>
</section>

<!-- Industry Grid Section -->
<section class="industries-grid-section" aria-labelledby="industries-grid-title">
  <div class="industries-shell">
    <header class="industries-section-header">
      <span class="industries-eyebrow">EXPLORE SOLUTIONS</span>
      <h2 id="industries-grid-title">Industry Solutions Built to Scale</h2>
      <p>Each industry presents unique operational challenges. We engineer tailored AI and automation solutions that fit your workflows.</p>
    </header>

    <div class="industries-grid">
      {industries.map((industry) => (
        <article class="industry-card">
          <div class="card-icon">{industry.icon}</div>
          <div class="card-header">
            <h3>{industry.name}</h3>
          </div>
          <div class="card-body">
            <p class="card-headline">{industry.headline}</p>
            <p class="card-description">{industry.description}</p>
          </div>
          <div class="card-footer">
            <a href={industry.route} class="card-link">Explore This Industry</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Cross-Industry Capabilities Section -->
<section class="capabilities-overview-section" aria-labelledby="capabilities-overview-title">
  <div class="industries-shell">
    <header class="capabilities-overview-header">
      <h2 id="capabilities-overview-title">Core Capabilities Across All Industries</h2>
      <p>Whether you're in healthcare, retail, finance or manufacturing, we apply these intelligent automation capabilities to your unique workflows.</p>
    </header>

    <div class="capabilities-overview-grid">
      <div class="capability-tile">
        <div class="capability-icon">🤖</div>
        <h3>AI Agents & Automation</h3>
        <p>Multi-agent systems that reason, plan and execute complex business workflows independently.</p>
      </div>
      <div class="capability-tile">
        <div class="capability-icon">📄</div>
        <h3>Intelligent Document Systems</h3>
        <p>AI-powered data extraction, processing and knowledge retrieval from documents at scale.</p>
      </div>
      <div class="capability-tile">
        <div class="capability-icon">🎤</div>
        <h3>Voice Agents</h3>
        <p>Natural conversational AI that answers calls, handles inquiries and completes transactions.</p>
      </div>
      <div class="capability-tile">
        <div class="capability-icon">⚙️</div>
        <h3>Workflow Automation</h3>
        <p>Connect disconnected systems, automate repetitive processes, synchronize data across platforms.</p>
      </div>
      <div class="capability-tile">
        <div class="capability-icon">💼</div>
        <h3>Business Integration</h3>
        <p>Custom integrations with your existing software, CRMs, ERPs and business systems.</p>
      </div>
      <div class="capability-tile">
        <div class="capability-icon">🌐</div>
        <h3>Custom Applications</h3>
        <p>Responsive web applications, portals and digital platforms built for your workflows.</p>
      </div>
    </div>
  </div>
</section>

<!-- 4-Step Approach Section -->
<section class="approach-section" aria-labelledby="approach-title">
  <div class="industries-shell">
    <header class="approach-header">
      <span class="approach-eyebrow">OUR PROCESS</span>
      <h2 id="approach-title">How We Implement Industry Solutions</h2>
      <p>A structured approach to understanding your workflows, designing solutions, and delivering results.</p>
    </header>

    <div class="approach-steps">
      <div class="step-card">
        <div class="step-number">01</div>
        <h3>Understand Your Workflows</h3>
        <p>We listen to your operational challenges, understand your current systems, and identify bottlenecks where AI and automation can deliver impact.</p>
      </div>
      <div class="step-card">
        <div class="step-number">02</div>
        <h3>Design Tailored Solutions</h3>
        <p>Based on industry best practices and your specific workflows, we design intelligent solutions that integrate with your existing infrastructure.</p>
      </div>
      <div class="step-card">
        <div class="step-number">03</div>
        <h3>Build & Integrate</h3>
        <p>Our engineering team builds your AI agents, automation workflows and custom applications, ensuring seamless integration with your existing systems.</p>
      </div>
      <div class="step-card">
        <div class="step-number">04</div>
        <h3>Deploy & Scale</h3>
        <p>We deploy your solution to production, provide training and support, and help you scale as your business grows.</p>
      </div>
    </div>
  </div>
</section>

<!-- Final CTA Section -->
<section class="industries-cta-section" aria-labelledby="industries-cta-title">
  <div class="industries-shell">
    <div class="cta-content">
      <h2 id="industries-cta-title">Ready to Transform Your Operations?</h2>
      <p>Let's discuss how intelligent automation can streamline your workflows and drive growth in your industry.</p>
      <a href="/contact/" class="cta-button">Discuss Your Workflow</a>
    </div>
  </div>
</section>

<style>
  .industries-hero {
    padding: 60px 1.5rem;
    background: linear-gradient(135deg, #0B1F44 0%, #102A43 50%, #1E3A5F 100%);
    color: #FFFFFF;
    text-align: center;
  }

  .industries-hero-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .industries-hero-content h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 1.2rem;
    letter-spacing: -0.02em;
  }

  .industries-hero-content p {
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  .industries-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .industries-grid-section {
    padding: 64px 1.5rem;
    background: linear-gradient(135deg, #f5f9fd 0%, #f9fafb 100%);
  }

  .industries-section-header {
    max-width: 760px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .industries-eyebrow,
  .approach-eyebrow {
    color: #2563eb;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .industries-section-header h2,
  .capabilities-overview-header h2,
  .approach-header h2 {
    margin: 0.8rem 0 0.8rem;
    color: #102a43;
    font: 700 clamp(1.8rem, 5vw, 2.8rem) / 1.1 "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
    letter-spacing: -0.02em;
  }

  .industries-section-header p,
  .capabilities-overview-header p,
  .approach-header p {
    max-width: 590px;
    margin: 0 auto;
    color: #62788e;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .industries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  @media (min-width: 1024px) {
    .industries-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .industry-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px;
    background: #FFFFFF;
    border: 1px solid #DCE7F3;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(23, 78, 166, 0.06), 0 1px 2px rgba(16, 42, 67, 0.03);
    outline: none;
  }

  .industry-card:hover {
    border-color: rgba(37, 99, 235, 0.3);
    box-shadow: 0 8px 16px rgba(23, 78, 166, 0.08);
  }

  .industry-card:focus-visible {
    outline: 2px solid #2563EB;
    outline-offset: 2px;
  }

  .card-icon {
    font-size: 2.8rem;
    margin-bottom: 12px;
    line-height: 1;
  }

  .card-header {
    margin-bottom: 12px;
    padding-bottom: 0;
    border-bottom: none;
  }

  .card-header h3 {
    margin: 0;
    color: #102A43;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .card-body {
    flex: 1;
    margin-bottom: 12px;
  }

  .card-headline {
    margin: 0 0 0.5rem;
    color: #102A43;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .card-description {
    margin: 0;
    color: #62788e;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .card-footer {
    border-top: none;
    padding-top: 0;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #2563EB;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .card-link:hover {
    color: #1D4ED8;
  }

  /* Capabilities Overview Section */
  .capabilities-overview-section {
    padding: 64px 1.5rem;
    background: #FFFFFF;
  }

  .capabilities-overview-header {
    max-width: 760px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .capabilities-overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  @media (min-width: 768px) {
    .capabilities-overview-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  .capability-tile {
    padding: 20px;
    background: linear-gradient(135deg, #f5f9fd 0%, #f9fafb 100%);
    border: 1px solid #E5ECF3;
    border-radius: 10px;
    text-align: center;
  }

  .capability-tile:hover {
    background: linear-gradient(135deg, #f0f7fc 0%, #f5f8fb 100%);
    border-color: rgba(34, 211, 238, 0.3);
    box-shadow: 0 4px 12px rgba(23, 78, 166, 0.06);
  }

  .capability-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1;
  }

  .capability-tile h3 {
    margin: 0 0 0.5rem;
    color: #102A43;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .capability-tile p {
    margin: 0;
    color: #62788e;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Approach Section */
  .approach-section {
    padding: 64px 1.5rem;
    background: linear-gradient(135deg, #f5f9fd 0%, #f9fafb 100%);
  }

  .approach-header {
    max-width: 760px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .approach-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  @media (min-width: 768px) {
    .approach-steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  .step-card {
    padding: 24px;
    background: #FFFFFF;
    border: 1px solid #DCE7F3;
    border-radius: 10px;
    text-align: center;
  }

  .step-card:hover {
    border-color: rgba(37, 99, 235, 0.3);
    box-shadow: 0 4px 12px rgba(23, 78, 166, 0.06);
  }

  .step-number {
    font-size: 1.8rem;
    font-weight: 700;
    color: #22D3EE;
    margin-bottom: 12px;
  }

  .step-card h3 {
    margin: 0 0 0.75rem;
    color: #102A43;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .step-card p {
    margin: 0;
    color: #62788e;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* CTA Section */
  .industries-cta-section {
    padding: 56px 1.5rem;
    background: linear-gradient(135deg, #0B1F44 0%, #102A43 50%, #1E3A5F 100%);
    color: #FFFFFF;
  }

  .cta-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-content h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .cta-content p {
    margin: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 28px;
    background: #22D3EE;
    color: #0B1F44;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(34, 211, 238, 0.25);
  }

  .cta-button:hover {
    background: #06B6D4;
    box-shadow: 0 4px 12px rgba(34, 211, 238, 0.35);
  }

  @media (max-width: 768px) {
    .industries-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .industries-grid-section {
      padding: 48px 1.5rem;
    }

    .industries-section-header {
      margin-bottom: 28px;
    }

    .approach-steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .capabilities-overview-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .approach-section,
    .capabilities-overview-section {
      padding: 48px 1.5rem;
    }

    .approach-header,
    .capabilities-overview-header {
      margin-bottom: 28px;
    }

    .industries-cta-section {
      padding: 48px 1.5rem;
    }

    .cta-content h2 {
      margin-bottom: 0.8rem;
    }

    .cta-content p {
      margin-bottom: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .industries-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
