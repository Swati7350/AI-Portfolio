---
/**
 * src/components/InsightsHero.astro
 * 
 * Hero section for Insights & Blogs page
 */
---

<section class="insights-hero">
  <div class="hero-content">
    <h1 class="hero-title">Insights for a Smarter, AI-Powered Future</h1>
    <p class="hero-description">
      Explore practical perspectives, technical insights and ideas shaping the future of artificial intelligence, intelligent automation and digital product engineering.
    </p>
    <a href="#articles" class="hero-cta">Explore Articles</a>
  </div>

  <div class="featured-preview">
    <div class="featured-label">Featured Article</div>
    <div class="featured-content">
      <div class="featured-image">
        <img 
          src="/assets/AI-Agents-Architecture.png" 
          alt="Multi-Agent AI System Architecture" 
          width="400"
          height="280"
        />
      </div>
      <div class="featured-info">
        <span class="featured-category">AI Agents & Automation</span>
        <h3 class="featured-title">Understanding Multi-Agent AI Systems: How Intelligent Agents Work Together</h3>
        <p class="featured-excerpt">Discover how multiple specialised AI agents collaborate, coordinate tasks and solve complex business problems through intelligent orchestration.</p>
        <a href="/insights/understanding-multi-agent-ai-systems/" class="featured-link">Read Article →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .insights-hero {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
  }

  .hero-content {
    text-align: center;
    margin-bottom: 4rem;
  }

  .hero-title {
    margin: 0 0 1.25rem;
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .hero-description {
    margin: 0 0 2.5rem;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: inline-block;
    padding: 12px 32px;
    background: var(--blue);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(22, 119, 255, 0.3);
  }

  @media (hover: hover) {
    .hero-cta:hover {
      background: var(--blue-hover);
      box-shadow: 0 6px 20px rgba(22, 119, 255, 0.4);
      transform: translateY(-2px);
    }
  }

  .hero-cta:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .featured-preview {
    background: linear-gradient(135deg, #f8fbff 0%, #ffffff 100%);
    border: 1px solid rgba(22, 119, 255, 0.15);
    border-radius: var(--radius);
    padding: 2rem;
    position: relative;
  }

  .featured-label {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .featured-content {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2rem;
    align-items: start;
  }

  .featured-image {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured-category {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .featured-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .featured-excerpt {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    color: var(--blue);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.25s ease;
    width: fit-content;
  }

  @media (hover: hover) {
    .featured-link:hover {
      color: var(--blue-hover);
      transform: translateX(2px);
    }
  }

  .featured-link:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .insights-hero {
      padding: 3rem 1.5rem 2.5rem;
    }

    .hero-title {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    .hero-description {
      font-size: 1rem;
      margin-bottom: 2rem;
    }

    .hero-cta {
      padding: 10px 24px;
      font-size: 0.9rem;
    }

    .featured-preview {
      padding: 1.5rem;
      margin-top: 2rem;
    }

    .featured-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .featured-image {
      aspect-ratio: 16 / 9;
    }

    .featured-title {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .insights-hero {
      padding: 2rem 1rem 1.5rem;
    }

    .hero-title {
      font-size: 1.5rem;
      margin-bottom: 0.75rem;
    }

    .hero-description {
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .featured-preview {
      padding: 1.25rem;
    }

    .featured-label {
      margin-bottom: 0.75rem;
    }

    .featured-title {
      font-size: 1.1rem;
    }

    .featured-excerpt {
      font-size: 0.85rem;
    }
  }
</style>
