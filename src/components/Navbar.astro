---
/**
 * src/components/Navbar.astro
 * 
 * Sticky navigation bar with logo and links
 */

import { site } from '../data/site';
import { caseStudies } from '../data/caseStudies';
const insightTopics = [
  'AI Engineering',
  'AI Agents & Automation',
  'Data & Document Intelligence',
  'Software & Digital Products',
];

// Get unique case study categories
const caseCategories = Array.from(
  new Set(caseStudies.flatMap(s => s.category.split('|').map(c => c.trim())))
).sort();

// Case studies organized by category
const caseStudiesByCategory = caseStudies.reduce((acc, study) => {
  const categories = study.category.split('|').map(c => c.trim());
  categories.forEach(cat => {
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(study);
  });
  return acc;
}, {} as Record<string, typeof caseStudies>);
---

<nav class="navbar" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label={`${site.title} — Home`}>
      <img src={site.logo} alt={site.title} width="52" height="52" />
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-controls="nav-menu" aria-expanded="false" aria-label="Toggle navigation menu">
      <span class="nav-toggle-line"></span>
      <span class="nav-toggle-line"></span>
      <span class="nav-toggle-line"></span>
    </button>
    <ul class="nav-links" id="nav-menu">
      <li><a href="/#solutions">Solutions</a></li>
      
      {/* Case Studies Mega Dropdown */}
      <li class="nav-dropdown nav-mega-dropdown">
        <a href="/case-studies/" class="nav-dropdown-text">Case Studies</a>
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false" aria-label="Open case studies menu"><span class="dropdown-icon">⌄</span></button>
        <div class="dropdown-menu mega-menu case-menu">
          <div class="mega-intro">
            <span class="mega-kicker">OUR WORK</span>
            <strong>Explore what we engineer.</strong>
            <a href="/case-studies/">View all case studies →</a>
          </div>
          {caseCategories.map(category => (
            <div class="mega-column">
              <a href={`/case-studies/?category=${encodeURIComponent(category)}`} class="mega-heading mega-link">
                {category}
              </a>
              {(caseStudiesByCategory[category] || []).map(study => (
                <a href={`/case-studies/${study.id}/`} class="case-study-link">
                  {study.title}
                </a>
              ))}
            </div>
          ))}
        </div>
      </li>

      {/* Insights Mega Dropdown */}
      <li class="nav-dropdown nav-mega-dropdown">
        <a href="/insights/" class="nav-dropdown-text">Insights</a>
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false" aria-label="Open insights menu"><span class="dropdown-icon">⌄</span></button>
        <div class="dropdown-menu mega-menu insights-menu">
          <div class="mega-intro">
            <span class="mega-kicker">IDEAS & PERSPECTIVES</span>
            <strong>Explore our latest thinking.</strong>
            <a href="/insights/">View all insights →</a>
          </div>
          <div class="mega-column">
            <span class="mega-heading">Browse by topic</span>
            {insightTopics.map(category => (
              <a href={`/insights/?category=${encodeURIComponent(category)}`} class="category-link">
                {category}
              </a>
            ))}
          </div>
        </div>
      </li>

      {/* Industries Dropdown */}
      <li class="nav-dropdown">
        <a href="/industries/" class="nav-dropdown-text">Industries</a>
        <button class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false" aria-label="Industries submenu">
          <span class="dropdown-icon">⌄</span>
        </button>
        <ul class="dropdown-menu">
          <li><a href="/industries/">All Industries</a></li>
          <li><a href="/industries/healthcare/">Healthcare</a></li>
          <li><a href="/industries/ecommerce-retail/">Ecommerce & Retail</a></li>
          <li><a href="/industries/manufacturing/">Manufacturing</a></li>
          <li><a href="/industries/finance-accounting/">Finance & Accounting</a></li>
          <li><a href="/industries/logistics-supply-chain/">Logistics & Supply Chain</a></li>
          <li><a href="/industries/professional-services/">Professional Services</a></li>
        </ul>
      </li>

      <li><a href="/work/">Recent Projects</a></li>
      <li><a href="/#work">Work</a></li>
      <li><a href="/#about">About</a></li>
      <li><a href="/contact/" class="nav-cta">Discuss Your Workflow</a></li>
    </ul>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-xs);
  }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-logo img {
    height: 52px;
    width: auto;
    display: block;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--blue);
  }

  .nav-links a:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  /* Dropdown styles */
  .nav-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-dropdown-text {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-dropdown-text:hover {
    color: var(--blue);
  }

  .nav-dropdown-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 6px;
    margin-left: 4px;
    transition: color 0.2s;
  }

  .nav-dropdown-trigger:hover,
  .nav-dropdown-trigger:focus-visible {
    color: var(--blue);
  }

  .nav-dropdown-trigger:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .dropdown-icon {
    font-size: 0.7rem;
    line-height: 1;
  }

  .nav-dropdown-trigger[aria-expanded="true"] .dropdown-icon {
    transform: scaleY(-1);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    list-style: none;
    margin: 0;
    padding: 8px 0;
    background: #FFFFFF;
    border: 1px solid #E5ECF3;
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(16, 42, 67, 0.1);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 1000;
    isolation: isolate;
  }

  .nav-dropdown:not(.nav-mega-dropdown):hover .dropdown-menu,
  .nav-dropdown:not(.nav-mega-dropdown):focus-within .dropdown-menu,
  .nav-dropdown-trigger[aria-expanded="true"] ~ .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .dropdown-menu li {
    margin: 0;
  }

  .dropdown-menu a {
    display: block;
    padding: 10px 16px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #62788e;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .dropdown-menu a:hover {
    background: rgba(34, 211, 238, 0.06);
    color: var(--blue);
  }

  .dropdown-menu a:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: -2px;
  }

  /* Mega menu styles */
  .nav-mega-dropdown {
    position: static;
  }

  /* On desktop the page label is the navigation link; the menu opens on hover/focus.
     Keep the arrow control for touch/mobile navigation only. */
  @media (min-width: 769px) {
    .nav-mega-dropdown > .nav-dropdown-trigger {
      display: none;
    }

    .nav-mega-dropdown.is-open > .mega-menu,
    .nav-mega-dropdown:focus-within > .mega-menu {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
  }

  .nav-mega-dropdown .mega-menu {
    left: 50%;
    transform: translateX(-50%);
    width: min(1080px, calc(100vw - 48px));
    padding: 24px;
    display: grid;
    gap: 24px;
    border-radius: 14px;
    position: absolute;
  }

  /* Case menu: intro + 3 columns */
  .nav-mega-dropdown .case-menu {
    grid-template-columns: 1.05fr 1fr 1fr 1fr;
  }

  /* Insights menu: intro + 2 columns (removed Selected Articles) */
  .nav-mega-dropdown .insights-menu {
    grid-template-columns: minmax(240px, 0.9fr) minmax(280px, 1.1fr);
  }

  .mega-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 4px 16px 4px 4px;
    border-right: 1px solid var(--border);
  }

  .mega-kicker,
  .mega-heading {
    color: var(--blue);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .mega-intro strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .mega-intro a {
    margin-top: auto;
    color: var(--blue) !important;
    padding: 0 !important;
    font-weight: 700 !important;
    background: transparent !important;
    font-size: 0.85rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mega-intro a:hover {
    text-decoration: underline;
  }

  .mega-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
  }

  .mega-column a {
    padding: 5px 0 !important;
    line-height: 1.4;
    white-space: normal;
  }

  /* Category links (clickable headings) */
  .mega-heading.mega-link {
    font-size: 0.85rem !important;
    padding: 0 !important;
    margin-bottom: 4px;
    cursor: pointer;
    text-transform: none;
    font-weight: 600;
  }

  .mega-heading.mega-link:hover {
    color: var(--blue-hover);
    text-decoration: underline;
  }

  /* Case study links */
  .case-study-link {
    color: #62788e !important;
    font-weight: 500;
    padding: 4px 0 !important;
  }

  .case-study-link:hover {
    color: var(--blue) !important;
  }

  /* Category links in insights */
  .category-link {
    display: block;
    width: 100%;
    color: #62788e !important;
    font-weight: 500;
    padding: 8px 0 !important;
    cursor: pointer;
    position: relative;
    z-index: 2;
    pointer-events: auto;
    text-decoration: none;
  }

  .category-link:hover {
    color: var(--blue) !important;
  }

  .mega-column a:hover {
    background: transparent !important;
    color: var(--blue) !important;
  }

  .nav-cta {
    background: #2563EB !important;
    color: #FFFFFF !important;
    padding: 8px 20px;
    border-radius: var(--radius-sm);
    font-size: 0.855rem !important;
    font-weight: 600 !important;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    display: inline-block;
    text-decoration: none;
  }

  .nav-cta:hover {
    background: #1D4ED8 !important;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
  }

  .nav-cta:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    margin: -8px;
  }

  .nav-toggle-line {
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: all 0.3s;
  }

  .nav-toggle.active .nav-toggle-line:nth-child(1) {
    transform: rotate(45deg) translate(10px, 10px);
  }

  .nav-toggle.active .nav-toggle-line:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.active .nav-toggle-line:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  @media (max-width: 768px) {
    .nav-inner {
      height: 64px;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 0;
      border-bottom: 1px solid var(--border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
      z-index: 99;
    }

    .nav-links.active {
      max-height: 100vh;
      overflow-y: auto;
    }

    .nav-links > li {
      border-bottom: 1px solid #E5ECF3;
    }

    .nav-links a {
      display: block;
      padding: 0.9rem 1.5rem;
      font-size: 0.85rem;
    }

    .nav-dropdown {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 48px;
      align-items: center;
      gap: 0;
    }

    .nav-dropdown-text {
      padding: 0.9rem 1.5rem;
      font-size: 0.85rem;
      display: block;
      min-width: 0;
    }

    .nav-dropdown-trigger {
      position: static;
      transform: none;
      width: 48px;
      height: 48px;
      padding: 0;
      margin: 0;
      justify-self: center;
      border: none;
      background: transparent;
    }

    .nav-mega-dropdown {
      width: 100%;
      display: block;
    }

    .nav-mega-dropdown .mega-menu,
    .nav-mega-dropdown .insights-menu {
      width: 100%;
      left: auto;
      transform: none;
      display: block;
      padding: 0 1rem;
      position: static;
      grid-template-columns: 1;
    }

    .mega-intro {
      padding: 12px 8px;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .mega-intro strong {
      font-size: 1rem;
    }

    .mega-column {
      padding: 10px 8px;
      gap: 4px;
    }

    .mega-column a {
      padding: 7px 0 !important;
    }

    .dropdown-menu {
      position: static;
      min-width: auto;
      background: #F9FAFB;
      border: none;
      box-shadow: none;
      border-radius: 0;
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      overflow: hidden;
      pointer-events: none;
      transition: max-height 0.3s ease;
      padding: 0;
      margin: 0;
    }

    .nav-dropdown-trigger[aria-expanded="true"] ~ .dropdown-menu {
      opacity: 1;
      visibility: visible;
      max-height: 75vh;
      pointer-events: auto;
    }

    .dropdown-menu a {
      padding: 0.8rem 1.5rem 0.8rem 2.5rem;
      font-size: 0.8rem;
    }

    .dropdown-menu a:hover {
      background: rgba(34, 211, 238, 0.08);
      padding-left: 2.7rem;
    }

    .nav-cta {
      margin: 1rem 1.5rem;
      padding: 10px 16px;
      font-size: 0.8rem !important;
      width: calc(100% - 3rem);
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .nav-inner {
      padding: 0 1rem;
    }

    .nav-logo img {
      height: 48px;
    }

    .nav-links a {
      padding: 0.8rem 1.25rem;
    }

    .dropdown-menu a {
      padding: 0.7rem 1.25rem 0.7rem 2rem;
    }

    .nav-cta {
      margin: 0.8rem 1.25rem;
      width: calc(100% - 2.5rem);
      padding: 8px 12px;
      font-size: 0.75rem !important;
    }
  }
</style>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const navMenu = document.getElementById('nav-menu');
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('.nav-mega-dropdown, .nav-dropdown:not(.nav-mega-dropdown)'));
  
  const closeMobileMenu = () => {
    navToggle?.classList.remove('active');
    navMenu?.classList.remove('active');
    navToggle?.setAttribute('aria-expanded', 'false');
    document.querySelectorAll('.nav-dropdown-trigger').forEach(trigger => trigger.setAttribute('aria-expanded', 'false'));
    document.querySelectorAll('.nav-mega-dropdown').forEach(dropdown => dropdown.classList.remove('is-open'));
  };

  navToggle?.addEventListener('click', () => {
    const expanded = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.classList.toggle('active', !expanded);
    navMenu?.classList.toggle('active', !expanded);
    navToggle.setAttribute('aria-expanded', String(!expanded));
  });

  dropdowns.forEach(dropdown => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
    const link = dropdown.querySelector<HTMLAnchorElement>('.nav-dropdown-text');
    let closeTimer: number | undefined;

    // Desktop mega menus use hover with a short grace period. The menu is a
    // descendant of this item, so moving into its panel keeps the pointer inside
    // the same interaction region. The delay protects small pointer transitions.
    if (dropdown.classList.contains('nav-mega-dropdown')) {
      dropdown.addEventListener('pointerenter', () => {
        if (window.matchMedia('(min-width: 769px) and (hover: hover)').matches) {
          if (closeTimer !== undefined) window.clearTimeout(closeTimer);
          dropdown.classList.add('is-open');
        }
      });

      dropdown.addEventListener('pointerleave', () => {
        if (window.matchMedia('(min-width: 769px) and (hover: hover)').matches) {
          if (closeTimer !== undefined) window.clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => {
            dropdown.classList.remove('is-open');
          }, 220);
        }
      });
    }

    // Arrow button remains the mobile/touch expansion control.
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      dropdowns.forEach(other => {
        other.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        other.classList.remove('is-open');
      });
      trigger.setAttribute('aria-expanded', String(!expanded));
    });

    // Main link always performs normal page navigation.
    link?.addEventListener('click', () => {
      if (window.innerWidth <= 768) closeMobileMenu();
    });

    // Dropdown menu links close the mobile navigation after selection.
    dropdown.querySelectorAll('.dropdown-menu a, .mega-menu a').forEach(menuLink => {
      menuLink.addEventListener('click', () => {
        if (window.innerWidth <= 768) closeMobileMenu();
      });
    });
  });

  navMenu?.querySelectorAll(':scope > li > a').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 768 && !link.classList.contains('nav-dropdown-text')) closeMobileMenu();
    });
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      closeMobileMenu();
    }
  });

  document.addEventListener('click', event => {
    dropdowns.forEach(dropdown => {
      if (!dropdown.contains(event.target as Node)) {
        dropdown.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
