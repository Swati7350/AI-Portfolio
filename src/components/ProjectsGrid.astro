---
/**
 * src/components/ProjectsGrid.astro
 * 
 * Displays projects in a grid with filtering capability
 * Used on both homepage and work page
 */
import ProjectCard from './ProjectCard.astro';
import { projects, getCategories } from '../data/projects';

interface Props {
  title?: string;
  subtitle?: string;
  showFilter?: boolean;
  limit?: number;
}

const { 
  title = "Selected Work", 
  subtitle = "AI systems and automation built to solve real business problems.",
  showFilter = true,
  limit = 3 
} = Astro.props;

// Get all unique categories from projects
const allCategories = getCategories();

// Display limited projects or all
const displayedProjects = limit ? projects.slice(0, limit) : projects;
---

<section class={`projects-section ${limit ? "projects-section-home" : "projects-section-listing"}`} id="work">
  <div class="section-inner">
    <div class="work-section-header">
      <div class="work-section-header-text">
        <span class="section-eyebrow">What We've Built</span>
        <h2 class="section-title">{title}</h2>
        <p class="section-subtitle">{subtitle}</p>
      </div>
    </div>

    {
      showFilter && (
        <div class="work-filter-area">
          <div class="filter-bar" role="group" aria-label="Filter projects by category">
            <button class="filter-btn active" data-filter="All">
              All
            </button>
            {allCategories.map((category) => (
              <button class="filter-btn" data-filter={category}>
                {category}
              </button>
            ))}
          </div>
          {limit && (
            <a href="/work" class="btn btn-ghost work-view-all-link">
              Explore Our Work →
            </a>
          )}
        </div>
      )
    }

    <div class="projects-carousel">
      <div class="projects-grid" id="projects-grid" data-limit={limit || 'all'}>
        {displayedProjects.map((project) => (
          <ProjectCard 
            id={project.id}
            title={project.name}
            description={project.description}
            categories={project.categories}
            image={project.image}
            liveUrl={project.live_url}
            githubUrl={project.github_url}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: 6rem 1rem;
    background: var(--bg);
  }

  .projects-section-listing {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .projects-section-listing .work-section-header {
    margin-bottom: 2rem;
  }

  .projects-section-listing .section-eyebrow {
    margin-bottom: 0.65rem;
  }

  .projects-section-listing .section-title {
    margin-bottom: 0.65rem;
  }

  .projects-section-listing .work-filter-area {
    margin-bottom: 2rem;
    gap: 1.25rem;
  }

  .projects-section-listing .filter-bar {
    gap: 0.75rem;
  }

  .projects-section-listing .projects-grid {
    gap: 1.5rem;
  }

  .section-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .work-section-header {
    margin-bottom: 3rem;
  }

  .work-section-header-text {
    text-align: center;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .work-filter-area {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .filter-bar {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .filter-btn {
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 50px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }

  .filter-btn:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .filter-btn:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: 2px;
  }

  .filter-btn.active {
    background: var(--blue);
    border-color: var(--blue);
    color: white;
  }

  .work-view-all-link {
    white-space: nowrap;
  }

  .projects-carousel {
    position: relative;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .projects-section {
      padding: 4rem 1rem;
    }

    .projects-section-listing {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .projects-section-listing .work-section-header {
      margin-bottom: 1.5rem;
    }

    .projects-section-listing .work-filter-area {
      margin-bottom: 1.5rem;
    }

    .work-filter-area {
      flex-direction: column;
      gap: 1.5rem;
    }

    .filter-bar {
      width: 100%;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Project filtering
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('[data-project-card]');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');

      // Update active button
      filterButtons.forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');

      // Filter projects
      projectCards.forEach((card) => {
        const categories = card.getAttribute('data-categories')?.split(',') || [];

        if (filter === 'All' || categories.includes(filter)) {
          card.style.display = '';
          card.style.opacity = '1';
        } else {
          card.style.opacity = '0';
          card.style.pointerEvents = 'none';
        }
      });
    });
  });
</script>
